<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>OtoServisApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Oto Servis Bakım</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.companyname.otoservisapp</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-android|AnyCPU'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\logo.png" Color="#1A222B" BaseSize="1024,1024" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\logo.png" Color="#1A222B" BaseSize="512,512" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
  </ItemGroup>

  <!-- SADECE ANDROID İÇİN -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <AndroidResource Include="Platforms\Android\Resources\drawable\appnotificationicon.png" />
  </ItemGroup>

  <!-- Manuel mipmap simgeleri (Android için) -->
  <ItemGroup>
    <AndroidResource Include="Resources\Drawable\mipmap-hdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-hdpi\ic_launcher_round.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-mdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-mdpi\ic_launcher_round.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-xhdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-xhdpi\ic_launcher_round.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-xxhdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-xxhdpi\ic_launcher_round.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-xxxhdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\Drawable\mipmap-xxxhdpi\ic_launcher_round.png" />
    <AndroidResource Include="Resources\Drawable\notification_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Platforms\Android\AndroidManifest.xml" />
    <None Remove="Platforms\Android\Resources\values\strings.xml" />
    <None Remove="Resources\AppIcon\appiconfg.svg" />
    <None Remove="Resources\Drawable\mipmap-hdpi\ic_launcher.png" />
    <None Remove="Resources\Drawable\mipmap-hdpi\ic_launcher_round.png" />
    <None Remove="Resources\Drawable\mipmap-mdpi\ic_launcher.png" />
    <None Remove="Resources\Drawable\mipmap-mdpi\ic_launcher_round.png" />
    <None Remove="Resources\Drawable\mipmap-xhdpi\ic_launcher.png" />
    <None Remove="Resources\Drawable\mipmap-xhdpi\ic_launcher_round.png" />
    <None Remove="Resources\Drawable\mipmap-xxhdpi\ic_launcher.png" />
    <None Remove="Resources\Drawable\mipmap-xxhdpi\ic_launcher_round.png" />
    <None Remove="Resources\Drawable\mipmap-xxxhdpi\ic_launcher.png" />
    <None Remove="Resources\Drawable\mipmap-xxxhdpi\ic_launcher_round.png" />
    <None Remove="Resources\Drawable\notification_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Platforms\Android\Resources\mipmap-hdpi\" />
    <Folder Include="Platforms\Android\Resources\mipmap-mdpi\" />
    <Folder Include="Platforms\Android\Resources\mipmap-xhdpi\" />
    <Folder Include="Platforms\Android\Resources\mipmap-xxhdpi\" />
    <Folder Include="Platforms\Android\Resources\mipmap-xxxhdpi\" />
    <Folder Include="Resources\AppIcon\" />
    <Folder Include="Resources\Splash\" />
    <Folder Include="Resources\Fonts\" />
  </ItemGroup>
    
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="7.0.1" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Plugin.Firebase" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <GoogleServicesJson Include="google-services.json" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.4.0.4" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.8.2.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.7.0.2" />
  </ItemGroup>
    
</Project>