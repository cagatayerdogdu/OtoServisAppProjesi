<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.AdminLogsView"
             BackgroundColor="#F0F2F5"
             Title="Sistem Logları">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <Border Grid.Row="0" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="10,10,10,5">
            <VerticalStackLayout Spacing="10">

                <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                    <Grid WidthRequest="200" VerticalOptions="Center">
                        <SearchBar x:Name="AramaBar" Placeholder="Kelime ara..." TextChanged="OnAramaDegisti" BackgroundColor="#FAFAFA" TextColor="#111111" Margin="30,0,0,0" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="14" TextColor="#888888" HorizontalOptions="Start" VerticalOptions="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                        <Label Text="Seviye:" VerticalOptions="Center" FontAttributes="Bold" TextColor="#333333" FontSize="12"/>
                        <Border Stroke="#CCCCCC" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 15" HeightRequest="35" Padding="5,0">
                            <Picker x:Name="SeviyePicker" SelectedIndex="1" TextColor="#111111" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Tümü</x:String>
                                    <x:String>ERROR</x:String>
                                    <x:String>WARNING</x:String>
                                    <x:String>INFO</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8">

                    <Border Grid.Column="0" Stroke="#CCCCCC" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" HeightRequest="35" Padding="5,0">
                        <Picker x:Name="TarihKriteriPicker" SelectedIndexChanged="OnTarihKriteriDegisti" TextColor="#111111" FontSize="12" BackgroundColor="Transparent" VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Bugün</x:String>
                                <x:String>Tek Tarih</x:String>
                                <x:String>İki Tarih Arası</x:String>
                                <x:String>Seçili Tarihten Sonra (&gt;=)</x:String>
                                <x:String>Seçili Tarihten Önce (&lt;=)</x:String>
                                <x:String>Tüm Zamanlar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Border Grid.Column="1" x:Name="BaslangicKutusu" IsVisible="False" Stroke="#CCCCCC" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" HeightRequest="35" Padding="5,0">
                        <DatePicker x:Name="BaslangicDatePicker" Format="dd.MM.yyyy" TextColor="#111111" BackgroundColor="Transparent" FontSize="12" VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Column="2" x:Name="BitisKutusu" IsVisible="False" Stroke="#CCCCCC" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" HeightRequest="35" Padding="5,0">
                        <DatePicker x:Name="BitisDatePicker" Format="dd.MM.yyyy" TextColor="#111111" BackgroundColor="Transparent" FontSize="12" VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Column="3" BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="35" Padding="0">
                        <Button Text="Sorgula" Clicked="OnSorgulaClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="12" Padding="15,0" BorderWidth="0" Margin="0"/>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="End" Margin="0,0,15,5" Spacing="5">
            <Label Text="{x:Static helpers:IconFont.ClipboardList}" FontFamily="FASolid" FontSize="11" TextColor="#888888" VerticalOptions="Center"/>
            <Label x:Name="KayitBilgiLabel" Text="Toplam: 0 | Filtrelenen: 0" FontSize="11" TextColor="#888888" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <CollectionView x:Name="LogsList" Grid.Row="2" Margin="10,0,10,5" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,0,0,10">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="14" TextColor="#00BCD4" VerticalOptions="Center"/>
                                    <Label Text="{Binding kullanici_ad_soyad}" FontAttributes="Bold" FontSize="14" TextColor="#111111" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="11" TextColor="#888888" VerticalOptions="Center"/>
                                    <Label Text="{Binding tarih}" FontSize="11" TextColor="#888888" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EEEEEE"/>

                            <HorizontalStackLayout Spacing="10">
                                <Border BackgroundColor="#FFF3CD" Stroke="Transparent" StrokeShape="RoundRectangle 6" Padding="8,4" VerticalOptions="Center">
                                    <Label Text="{Binding seviye}" FontSize="11" FontAttributes="Bold" TextColor="#856404"/>
                                </Border>
                                <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="12" TextColor="#0056b3" VerticalOptions="Center"/>
                                <Label Text="{Binding islem}" FontSize="12" FontAttributes="Bold" TextColor="#0056b3" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="2" Margin="0,5,0,0">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.ClipboardList}" FontFamily="FASolid" FontSize="12" TextColor="#666666" VerticalOptions="Center"/>
                                    <Label Text="Log Detayı:" FontSize="11" TextColor="#666666" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding detay}" FontSize="12" TextColor="#333333" LineBreakMode="CharacterWrap" MaxLines="4"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="10,0,10,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Border Grid.Column="0" BackgroundColor="#EEEEEE" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="35" WidthRequest="90" Padding="0">
                    <Button x:Name="OncekiSayfaBtn" Text="◀ Önceki" Clicked="OnOncekiSayfaClicked" BackgroundColor="Transparent" TextColor="#333333" FontSize="12" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                </Border>

                <Label x:Name="SayfaBilgiLabel" Grid.Column="1" Text="Sayfa 1 / 1" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="#111111"/>

                <Border Grid.Column="2" BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="35" WidthRequest="90" Padding="0">
                    <Button x:Name="SonrakiSayfaBtn" Text="Sonraki ▶" Clicked="OnSonrakiSayfaClicked" BackgroundColor="Transparent" TextColor="White" FontSize="12" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>