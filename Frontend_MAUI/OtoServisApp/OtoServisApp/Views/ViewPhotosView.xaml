<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.ViewPhotosView"
             Title="Hasar Fotoğrafları"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Talebe Eklenen Görseller" FontSize="20" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
            <Label Text="Görselleri büyütmek için üzerine tıklayabilirsiniz." FontSize="13" TextColor="#666666" HorizontalOptions="Center" Margin="0,-10,0,10"/>

            <FlexLayout x:Name="PhotosLayout" Wrap="Wrap" JustifyContent="SpaceBetween">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" StrokeThickness="1" WidthRequest="160" HeightRequest="160" Margin="0,0,0,15" BackgroundColor="White">
                            <Grid>
                                <Image Source="{Binding TamUrl, Mode=OneWay}" Aspect="AspectFill" WidthRequest="160" HeightRequest="160">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding TamUrl, Mode=OneWay}" Tapped="OnPhotoTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>

                                <Border BackgroundColor="#EF4444" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 15" WidthRequest="30" HeightRequest="30" HorizontalOptions="End" VerticalOptions="Start" Margin="5" Padding="0">
                                    <Button Text="X" CommandParameter="{Binding .}" Clicked="OnDeletePhotoClicked" BackgroundColor="Transparent" TextColor="White" FontSize="12" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>