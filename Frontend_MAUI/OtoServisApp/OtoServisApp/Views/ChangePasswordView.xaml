<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.ChangePasswordView"
             BackgroundColor="#F4F6F8"
             Title="Şifre Değiştir">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,30">
            <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 15" Padding="25" Stroke="Transparent">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Mevcut Şifreniz" TextColor="#666666" FontSize="13" />
                        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                            <Entry x:Name="OldPasswordEntry" IsPassword="True" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5" Margin="0,10,0,0">
                        <Label Text="Yeni Şifreniz" TextColor="#666666" FontSize="13" />
                        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                            <Entry x:Name="NewPasswordEntry" IsPassword="True" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Yeni Şifreniz (Tekrar)" TextColor="#666666" FontSize="13" />
                        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                            <Entry x:Name="ConfirmPasswordEntry" IsPassword="True" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        </Border>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,15,0,0" Padding="0">
                        <Button x:Name="SaveButton" Text="ŞİFREYİ GÜNCELLE" Clicked="OnSaveClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>