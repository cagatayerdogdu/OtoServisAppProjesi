<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             x:Class="OtoServisApp.Views.EditServiceRequestView"
             Title="Talebi Düzenle"
             BackgroundColor="#F4F6F8">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Border BackgroundColor="#E0F7FA" Stroke="#00BCD4" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Mevcut Durum:" FontAttributes="Bold" TextColor="#006064" VerticalOptions="Center"/>
                        <Label x:Name="DurumLabel" FontAttributes="Bold" TextColor="#00BCD4" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Label x:Name="ReadOnlyWarningLabel" Text="Bu talep sonlandığı için üzerinde değişiklik yapılamaz." TextColor="#D32F2F" FontAttributes="Bold" IsVisible="False" HorizontalOptions="Center"/>

                <VerticalStackLayout x:Name="StandartDuzenlemeFormu" Spacing="15">

                    <Label Text="Hizmet Seçimi" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>

                    <Border BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                        <Button x:Name="SecilenHizmetButonu" Text="Lütfen bir hizmet seçin..." BackgroundColor="Transparent" TextColor="#666666" BorderWidth="0" Clicked="OnHizmetSecimButonuClicked" Margin="0" Padding="0"/>
                    </Border>

                    <Border x:Name="HizmetAramaKutusu" IsVisible="False" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,10">
                        <VerticalStackLayout Spacing="5">
                            <SearchBar x:Name="HizmetAramaBar" Placeholder="Hizmet ara... (Örn: Fren, Yağ)" TextChanged="OnHizmetAramaDegisti" BackgroundColor="#F9F9F9" TextColor="#111111" CancelButtonColor="#D32F2F" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                            <CollectionView x:Name="HizmetListesi" HeightRequest="200" SelectionMode="Single" SelectionChanged="OnHizmetSecildi">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Hizmet">
                                        <VerticalStackLayout Padding="10">
                                            <Label Text="{Binding ad, Mode=OneWay}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                            <Label Text="{Binding aciklama, Mode=OneWay}" FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Araç Seçimi" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>

                    <Border BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                        <Button x:Name="SecilenAracButonu" Text="Lütfen bir araç seçin..." BackgroundColor="Transparent" TextColor="#666666" BorderWidth="0" Clicked="OnAracSecimButonuClicked" Margin="0" Padding="0"/>
                    </Border>

                    <Border x:Name="AracAramaKutusu" IsVisible="False" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,10">
                        <VerticalStackLayout Spacing="5">
                            <CollectionView x:Name="AracListesi" HeightRequest="150" SelectionMode="Single" SelectionChanged="OnAracSecildi">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Padding="10">
                                            <Label Text="{Binding marka_model_yazi, Mode=OneWay}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                            <Label Text="{Binding yil, StringFormat='{0} Model', Mode=OneWay}" FontSize="11" TextColor="#888888"/>
                                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Talep Edilen Tarih" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                    <DatePicker x:Name="TarihPicker" MinimumDate="{Binding Source={x:Static x:DateTime.Today}}" BackgroundColor="#FAFAFA" TextColor="#111111"/>

                    <Label Text="Adresiniz" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                    <Editor x:Name="AdresEditor" HeightRequest="80" BackgroundColor="#FAFAFA" TextColor="#111111" PlaceholderColor="#888888" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                    <Label Text="Ek Notlar" FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                    <Editor x:Name="NotlarEditor" HeightRequest="80" BackgroundColor="#FAFAFA" TextColor="#111111" PlaceholderColor="#888888" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{x:Static helpers:IconFont.Camera}" FontFamily="FASolid" FontSize="16" TextColor="#666666" VerticalOptions="Center"/>
                        <Label Text="Yeni Hasar Fotoğrafı Ekle (Maks 4)" TextColor="#666666" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="#E0F2F1" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Margin="0,0,0,5" Padding="0">
                        <Button Text="+ Fotoğrafları Seç (Toplu)" Clicked="OnAddPhotoClicked" BackgroundColor="Transparent" TextColor="#00796B" BorderWidth="0" Margin="0" Padding="0"/>
                    </Border>

                    <FlexLayout x:Name="PhotosContainer" BindableLayout.ItemsSource="{Binding SecilenFotograflar}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="80" HeightRequest="80" Margin="0,0,10,10">
                                    <Image Source="{Binding FullPath, Mode=OneWay}" Aspect="AspectFill" WidthRequest="80" HeightRequest="80"/>
                                    <Border BackgroundColor="#EF4444" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="25" HeightRequest="25" HorizontalOptions="End" VerticalOptions="Start" Margin="3" Padding="0">
                                        <Button Text="X" CommandParameter="{Binding .}" Clicked="OnRemovePhotoClicked" BackgroundColor="Transparent" TextColor="White" BorderWidth="0" FontSize="10" FontAttributes="Bold" Margin="0" Padding="0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="DuzeltmeTalebiFormu" Spacing="15" IsVisible="False">
                    <Label Text="Yöneticiye Düzeltme İletin" FontSize="16" FontAttributes="Bold" TextColor="#F57C00"/>
                    <Label Text="Talebiniz onaylandığı için doğrudan değiştiremezsiniz. Lütfen düzeltmek istediğiniz kısımları (örn: adres değişikliği) aşağıya yazarak yöneticiye iletin." FontSize="12" TextColor="#666666"/>
                    <Editor x:Name="DuzeltmeNotuEditor" HeightRequest="100" Placeholder="Düzeltme talebinizi buraya yazın..." BackgroundColor="#FAFAFA" TextColor="#111111" PlaceholderColor="#888888" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                </VerticalStackLayout>

                <Border BackgroundColor="#4CAF50" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,20,0,0" Padding="0">
                    <Button x:Name="KaydetButton" Text="Değişiklikleri Kaydet" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" Clicked="OnKaydetClicked" BorderWidth="0" Margin="0" Padding="0"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Lütfen Bekleyiniz..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="İşleminiz gerçekleştiriliyor." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>