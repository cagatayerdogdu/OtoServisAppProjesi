<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             xmlns:views="clr-namespace:OtoServisApp.Views"
             x:Class="OtoServisApp.Views.AdminUserTrackingView"
             Title="Müşteri Takibi"
             BackgroundColor="#F5F6FA">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,10,10,20">
            <Label Grid.Column="0" Text="Uzun Süredir Girmeyenler" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center"/>
            <Border Grid.Column="1" BackgroundColor="#FF9800" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="15,5" HorizontalOptions="End" VerticalOptions="Center">
                <Label x:Name="ToplamLabel" Text="0 Kişi" FontSize="13" FontAttributes="Bold" TextColor="White"/>
            </Border>
        </Grid>

        <CollectionView Grid.Row="1" x:Name="TrackingList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:TakipMusteri">

                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15" Margin="5,5,5,10">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15" VerticalOptions="Center">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding ad_soyad, Mode=OneWay}" FontSize="16" FontAttributes="Bold" TextColor="#333333"/>
                                <Label Text="{Binding eposta, Mode=OneWay}" FontSize="13" TextColor="#7F8C8D"/>
                                <Label Text="{Binding SonGirisText, Mode=OneWay}" FontSize="12" TextColor="#555555"/>
                                <Label Text="{Binding KacGunText, Mode=OneWay}" FontSize="12" TextColor="#E74C3C" FontAttributes="Bold"/>
                                <Label Text="{Binding MailIzinDurum, Mode=OneWay}" FontSize="11" TextColor="{Binding MailIzinRengi, Mode=OneWay}" FontAttributes="Bold"/>

                                <Label Text="{Binding SonHatirlatmaText, Mode=OneWay}" FontSize="11" TextColor="{Binding HatirlatmaRenk, Mode=OneWay}" FontAttributes="Bold" Margin="0,4,0,0"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="1" BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" VerticalOptions="Center" Padding="0">
                                <Button Text="Hatırlat" Clicked="OnSendReminderClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="White" Padding="15,0" BorderWidth="0" IsEnabled="{Binding mail_istiyor_mu, Mode=OneWay}" Margin="0"/>
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="20" Padding="10,20">
            <Border BackgroundColor="#E0E6ED" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="0">
                <Button x:Name="BtnGeri" Text="&lt; Geri" Clicked="OnPrev" BackgroundColor="Transparent" TextColor="#2C3E50" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="15,0"/>
            </Border>

            <Label x:Name="PageInfo" Text="1 / 1" VerticalOptions="Center" TextColor="#2C3E50" FontAttributes="Bold"/>

            <Border BackgroundColor="#E0E6ED" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="0">
                <Button x:Name="BtnIleri" Text="İleri &gt;" Clicked="OnNext" BackgroundColor="Transparent" TextColor="#2C3E50" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="15,0"/>
            </Border>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>