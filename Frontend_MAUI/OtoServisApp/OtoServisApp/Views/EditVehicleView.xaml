<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.EditVehicleView"
             BackgroundColor="#F4F6F8"
             Title="Aracı Düzenle">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,30">

            <Border x:Name="UyariKutusu" IsVisible="False" BackgroundColor="#FFF3CD" Stroke="#FFEEBA" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="20" TextColor="#856404" VerticalOptions="Center"/>
                    <Label Text="Bu araç serviste işlem gördüğü için Marka/Model değiştirilemez. Sadece Yıl ve Kilometre güncelleyebilirsiniz." TextColor="#856404" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="FillAndExpand" LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="25" Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Araç Markası" TextColor="#666666" FontSize="13" FontAttributes="Bold" />

                        <Border BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                            <Button x:Name="SecilenMarkaButonu" Text="Lütfen marka seçin..." BackgroundColor="Transparent" TextColor="#666666" BorderWidth="0" Clicked="OnMarkaSecimButonuClicked" Margin="0" Padding="0"/>
                        </Border>

                        <Border x:Name="MarkaAramaKutusu" IsVisible="False" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,0">
                            <VerticalStackLayout Spacing="5">
                                <SearchBar x:Name="MarkaAramaBar" Placeholder="Marka ara..." TextChanged="OnMarkaAramaDegisti" BackgroundColor="#F9F9F9" TextColor="#111111" CancelButtonColor="#D32F2F" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                                <CollectionView x:Name="MarkaListesi" HeightRequest="200" SelectionMode="Single" SelectionChanged="OnMarkaSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="10">
                                                <Label Text="{Binding ad}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Araç Modeli" TextColor="#666666" FontSize="13" FontAttributes="Bold" />

                        <Border BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                            <Button x:Name="SecilenModelButonu" Text="Önce marka seçmelisiniz" IsEnabled="False" BackgroundColor="Transparent" TextColor="#888888" BorderWidth="0" Clicked="OnModelSecimButonuClicked" Margin="0" Padding="0"/>
                        </Border>

                        <Border x:Name="ModelAramaKutusu" IsVisible="False" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,0">
                            <VerticalStackLayout Spacing="5">
                                <SearchBar x:Name="ModelAramaBar" Placeholder="Model ara..." TextChanged="OnModelAramaDegisti" BackgroundColor="#F9F9F9" TextColor="#111111" CancelButtonColor="#D32F2F" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                                <CollectionView x:Name="ModelListesi" HeightRequest="200" SelectionMode="Single" SelectionChanged="OnModelSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="10">
                                                <Label Text="{Binding ad}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Üretim Yılı" TextColor="#666666" FontSize="13" FontAttributes="Bold" />
                        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 8" Padding="15,5">
                            <Entry x:Name="YilEntry" Keyboard="Numeric" MaxLength="4" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Güncel Kilometre" TextColor="#666666" FontSize="13" FontAttributes="Bold" />
                        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 8" Padding="15,5">
                            <Entry x:Name="KmEntry" Keyboard="Numeric" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        </Border>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,15,0,0" Padding="0">
                        <Button x:Name="UpdateButton" Text="GÜNCELLE" Clicked="OnUpdateClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>