<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.AdminPriceManagementView"
             Title="Fiyat Yönetimi"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, Auto, *">
        <VerticalStackLayout Grid.Row="0" Margin="20,20,20,10" Spacing="5">
            <Label Text="Hizmet Fiyatlandırması" FontSize="22" FontAttributes="Bold" TextColor="#2C3E50"/>
            <Label Text="Uygulama içindeki hizmetlerin standart fiyatlarını buradan güncelleyebilirsiniz." FontSize="14" TextColor="#7F8C8D"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="White" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15,0" Margin="15,0,15,10" HeightRequest="45">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="16" TextColor="#00BCD4" VerticalOptions="Center"/>
                <Entry Grid.Column="1" x:Name="HizmetSearchEntry" Placeholder="Hizmet ara..." TextChanged="OnHizmetAraTextChanged" TextColor="#333333" PlaceholderColor="#7F8C8D" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <CollectionView x:Name="HizmetlerListesi" Grid.Row="2" Margin="15,0,15,20">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0" Spacing="10">
                    <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="36" TextColor="#00BCD4" HorizontalOptions="Center" />
                    <Label Text="Aradığınız hizmet bulunamadı..." FontSize="16" FontAttributes="Bold" TextColor="#95A5A6" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,5,0,5">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">

                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Wrench}" FontFamily="FASolid" FontSize="16" TextColor="#00BCD4" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding ad}" FontSize="16" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                            </Grid>

                            <Frame Grid.Column="1" Padding="0" BorderColor="#CCCCCC" CornerRadius="5" WidthRequest="90" HeightRequest="40" HasShadow="False" VerticalOptions="Center">
                                <Entry Text="{Binding varsayilan_fiyat}" Keyboard="Numeric" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="#111111" FontSize="15" BackgroundColor="Transparent" ClearButtonVisibility="Never"/>
                            </Frame>

                            <Button Grid.Column="2" Text="Kaydet" BackgroundColor="#00BCD4" TextColor="White" CornerRadius="5" HeightRequest="40" Padding="10,0" Clicked="OnFiyatGuncelleClicked" CommandParameter="{Binding .}" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>