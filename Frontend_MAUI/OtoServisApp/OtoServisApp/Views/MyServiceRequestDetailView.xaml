<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             x:Class="OtoServisApp.Views.MyServiceRequestDetailView"
             BackgroundColor="#F4F6F8"
             Title="Talep Detayı">

    <Grid RowDefinitions="*">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">
                <!-- Hizmet Bilgisi -->
                <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{x:Static helpers:IconFont.Wrench}" FontFamily="FASolid" FontSize="16" TextColor="#666666" VerticalOptions="Center"/>
                            <Label Text="{Binding hizmet_adi, Mode=OneWay}" FontSize="18" FontAttributes="Bold" TextColor="#333333"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="16" TextColor="#666666" VerticalOptions="Center"/>
                            <Label Text="{Binding arac_adi, Mode=OneWay}" FontSize="16" TextColor="#666666" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Durum -->
                <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Durum:" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding durum, Mode=OneWay}" TextColor="#00BCD4" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Maliyet -->
                <Border BackgroundColor="#E0F7FA" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="20">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="Maliyet:" TextColor="#00796B" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding tahmini_tutar, StringFormat='{0} ₺', Mode=OneWay}" TextColor="#004D40" FontSize="18" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Talep Tarihi -->
                <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="14" TextColor="#666666"/>
                        <Label Text="İstediğiniz Tarih:" TextColor="#666666" FontSize="14"/>
                        <Label Text="{Binding talep_tarihi, Mode=OneWay}" TextColor="#111111" FontSize="14" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Adres -->
                <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Adres" FontAttributes="Bold" TextColor="#333333"/>
                        <Label Text="{Binding adres, Mode=OneWay}" FontSize="13" TextColor="#555555" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Notlar -->
                <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Müşteri Notu" FontAttributes="Bold" TextColor="#333333"/>
                        <Label Text="{Binding notlar, Mode=OneWay}" FontSize="13" TextColor="#555555" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Düzeltme Talebi Uyarısı -->
                <Border IsVisible="{Binding duzeltme_istendi_mi, Mode=OneWay}" BackgroundColor="#FFEBEE" Stroke="#D32F2F" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="14" TextColor="#C62828"/>
                            <Label Text="Düzeltme Talebi Var!" FontSize="14" FontAttributes="Bold" TextColor="#C62828"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding duzeltme_notu, Mode=OneWay}" FontSize="12" TextColor="#333333" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Önerilen Tarih -->
                <Border IsVisible="{Binding onerilen_tarih_var_mi, Mode=OneWay}" BackgroundColor="#FFEBEE" Stroke="#E53935" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="14" TextColor="#E53935"/>
                        <Label Text="Önerilen Yeni Tarih:" TextColor="#E53935" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="{Binding onerilen_tarih, Mode=OneWay}" TextColor="#E53935" FontSize="14" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Fotoğraf Var Alanı -->
                <Border BackgroundColor="#FFF3E0" Stroke="#FFCC80" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="{Binding foto_var_mi, Mode=OneWay}">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.Camera}" FontFamily="FASolid" FontSize="16" TextColor="#E65100"/>
                                <Label Text="Görsel Eklenmiş Talep" TextColor="#E65100" FontAttributes="Bold" FontSize="14"/>
                            </HorizontalStackLayout>
                            <Label Text="Bu talebe detaylı hasar fotoğrafları yüklediniz." TextColor="#F57C00" FontSize="12"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="1" BackgroundColor="#FF9800" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6" HeightRequest="40" Padding="15,0" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewPhotosTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="Fotoğrafları Gör" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Düzenle / İptal Butonları -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10">
                    <Border Grid.Column="0" BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="Düzenle" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#FFEBEE" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="İptal Et" TextColor="#D32F2F" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- LOADING OVERLAY -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="İşlem Yapılıyor..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="Lütfen işlem bitene kadar bekleyiniz." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>