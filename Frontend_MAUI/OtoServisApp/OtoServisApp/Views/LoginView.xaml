<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.LoginView"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4.5*" />
            <RowDefinition Height="5.5*" />
        </Grid.RowDefinitions>

        <BoxView Grid.Row="0" BackgroundColor="#1A222B" />
        <BoxView Grid.Row="1" BackgroundColor="#F8FAFC" />

        <ScrollView Grid.RowSpan="2" VerticalOptions="Fill" HorizontalOptions="Fill">

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" Spacing="25" Padding="20,0" Margin="0,-80,0,0">

                <Image Source="logo.png" HeightRequest="240" WidthRequest="240" BackgroundColor="Transparent" HorizontalOptions="Center" Margin="0,0,0,5" />

                <Border BackgroundColor="White" Stroke="Transparent" StrokeShape="RoundRectangle 16" WidthRequest="340" HorizontalOptions="Center" Padding="25,30" Margin="0,-70,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#222222" Offset="0,15" Radius="25" Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Hesabınıza Giriş Yapın" FontSize="18" FontAttributes="Bold" TextColor="#334155" Margin="0,0,0,10" HorizontalOptions="Center"/>

                        <Border Padding="15,0" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="50" BackgroundColor="#F8FAFC">
                            <Entry x:Name="EmailEntry" Placeholder="E-posta adresiniz" Keyboard="Email" TextColor="#334155" BackgroundColor="Transparent"/>
                        </Border>

                        <Border Padding="15,0" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" HeightRequest="50" BackgroundColor="#F8FAFC">
                            <Entry x:Name="PasswordEntry" Placeholder="Şifreniz" IsPassword="True" TextColor="#334155" BackgroundColor="Transparent"/>
                        </Border>

                        <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,10">
                            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                <CheckBox x:Name="BeniHatirlaCheckBox" IsChecked="True" Color="#0EA5E9" Scale="0.8"/>
                                <Label Text="Beni Hatırla" VerticalOptions="Center" FontSize="13" TextColor="#64748B"/>
                            </HorizontalStackLayout>

                            <Label Grid.Column="1" Text="Şifremi Unuttum" TextColor="#0EA5E9" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Button x:Name="LoginButton" Text="Giriş Yap" Clicked="OnLoginClicked" BackgroundColor="#0EA5E9" TextColor="White" HeightRequest="50" CornerRadius="10" FontSize="16" FontAttributes="Bold"/>

                        <Label Text="Üye olmadan devam et" TextColor="Green" TextDecorations="Underline" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" Margin="0,15,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGuestContinueTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,5,0,0">
                    <Label Text="Hesabınız yok mu?" TextColor="#64748B" FontSize="14"/>
                    <Label Text="Hemen Kayıt Olun" TextColor="#0EA5E9" FontSize="14" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>