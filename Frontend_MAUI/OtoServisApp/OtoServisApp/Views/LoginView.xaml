<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.LoginView"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,50" VerticalOptions="Center">

            <VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,10">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,0,0,-15">
                    <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="45" TextColor="{StaticResource Tertiary}" />
                    <Label Text="{x:Static helpers:IconFont.Wrench}" FontFamily="FASolid" FontSize="35" TextColor="{StaticResource Primary}" Margin="0,10,0,0" />
                </HorizontalStackLayout>
                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Kapıdan " FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Tertiary}"/>
                            <Span Text="Bakım" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Aracınızın bakımı kapıdan başlar." FontSize="14" TextColor="#888888" HorizontalOptions="Center" Margin="0,5,0,0"/>
            </VerticalStackLayout>

            <Border BackgroundColor="#FAFAFA" 
                    StrokeShape="RoundRectangle 15"
                    Stroke="Transparent"
                    MaximumWidthRequest="400" 
                    HorizontalOptions="Center"
                    Padding="30,30">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Hesabınıza Giriş Yapın" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Tertiary}" 
                           HorizontalOptions="Center" 
                           Margin="0,0,0,10"/>

                    <Entry x:Name="EmailEntry" 
                           Placeholder="E-Posta Adresiniz" 
                           Keyboard="Email" 
                           TextColor="{StaticResource Tertiary}"
                           PlaceholderColor="{StaticResource Gray400}"/>

                    <Entry x:Name="PasswordEntry" 
                           Placeholder="Şifreniz" 
                           IsPassword="True" 
                           TextColor="{StaticResource Tertiary}"
                           PlaceholderColor="{StaticResource Gray400}"
                           ReturnType="Go"
                           Completed="OnLoginClicked"/>
                    
                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,15">
                        <CheckBox x:Name="BeniHatirlaCheckBox" IsChecked="True" Color="{StaticResource Primary}" />
                        <Label Text="Beni Hatırla" VerticalOptions="Center" TextColor="#888888" FontSize="14" FontAttributes="Bold"/>
                    </HorizontalStackLayout>

                    <Label Text="Şifremi Unuttum?" TextColor="#00BCD4" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Button x:Name="LoginButton" 
                            Text="GİRİŞ YAP" 
                            Clicked="OnLoginClicked"
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            CornerRadius="8"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,10,0,0"/>

                    <Label Text="Üye olmadan devam et" 
                           TextColor="#888888" 
                           TextDecorations="Underline" 
                           HorizontalOptions="Center" 
                           Margin="0,20,0,0"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGuestContinueTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,15"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="Hesabınız yok mu?" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                        <Label Text="Kayıt Olun" 
                               TextColor="{StaticResource PrimaryDark}"
                               FontAttributes="Bold"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>