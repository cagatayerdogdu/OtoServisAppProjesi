<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.ForgotPasswordView"
             BackgroundColor="#F4F6F8"
             Title="Şifremi Unuttum">

    <VerticalStackLayout Spacing="20" Padding="30,50">
        <Label Text="Şifrenizi mi Unuttunuz?" FontSize="24" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
        <Label Text="Kayıtlı e-posta adresinizi girin, size bir sıfırlama bağlantısı gönderelim." TextColor="#666666" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,-10,0,10"/>

        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
            <Entry x:Name="EmailEntry" Placeholder="E-Posta Adresiniz" Keyboard="Email" TextColor="#111111" BackgroundColor="Transparent"/>
        </Border>

        <Button x:Name="ResetButton" Text="SIFIRLAMA BAĞLANTISI GÖNDER" Clicked="OnResetClicked" BackgroundColor="#00BCD4" TextColor="White" CornerRadius="8" HeightRequest="50" FontAttributes="Bold" Margin="0,10,0,0"/>
    </VerticalStackLayout>
</ContentPage>