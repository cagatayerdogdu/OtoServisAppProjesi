<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.RegisterView"
             BackgroundColor="#F4F6F8"
             Title="Yeni Kayıt Oluştur">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,50">

            <Label Text="Hesap Oluştur" FontSize="28" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
            <Label Text="Saniyeler içinde aracınızı yönetmeye başlayın." TextColor="#666666" HorizontalOptions="Center" Margin="0,-15,0,10"/>

            <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 15" Padding="25" Stroke="Transparent">
                <VerticalStackLayout Spacing="10" Margin="0,0,0,20">

                    <!-- Ad Soyad -->
                    <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="18" VerticalOptions="Center" TextColor="#555555"/>
                            <Entry Grid.Column="1" x:Name="NameEntry" 
                                   Placeholder="Ad Soyad" 
                                   TextColor="#111111" 
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"/>
                        </Grid>
                    </Border>

                    <!-- Telefon -->
                    <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Phone}" FontFamily="FASolid" FontSize="18" VerticalOptions="Center" TextColor="#555555"/>
                            <Entry Grid.Column="1" x:Name="PhoneEntry" 
                                   Placeholder="Telefon" 
                                   Keyboard="Telephone" 
                                   TextColor="#111111" 
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"/>
                        </Grid>
                    </Border>

                    <!-- E-posta -->
                    <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Envelope}" FontFamily="FASolid" FontSize="18" VerticalOptions="Center" TextColor="#555555"/>
                            <Entry Grid.Column="1" x:Name="EmailEntry" 
                                   Placeholder="E-posta Adresi" 
                                   Keyboard="Email" 
                                   TextColor="#111111" 
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"/>
                        </Grid>
                    </Border>

                    <!-- Şifre -->
                    <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Lock}" FontFamily="FASolid" FontSize="18" VerticalOptions="Center" TextColor="#555555"/>
                            <Entry Grid.Column="1" x:Name="PasswordEntry" 
                                   Placeholder="Şifre Belirleyin" 
                                   IsPassword="True" 
                                   TextColor="#111111" 
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"/>
                        </Grid>
                    </Border>

                    <!-- Şifre Tekrar -->
                    <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{x:Static helpers:IconFont.Lock}" FontFamily="FASolid" FontSize="18" VerticalOptions="Center" TextColor="#555555"/>
                            <Entry Grid.Column="1" x:Name="SifreTekrarEntry" 
                                   Placeholder="Şifrenizi Tekrar Girin" 
                                   IsPassword="True" 
                                   TextColor="#111111" 
                                   BackgroundColor="Transparent"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"/>
                        </Grid>
                    </Border>

                    <!-- Mail İzni -->
                    <HorizontalStackLayout Spacing="8" Margin="0,10,0,10" VerticalOptions="Center">
                        <CheckBox x:Name="MailIzniCheckBox" IsChecked="True" Color="#00BCD4" Scale="0.9" VerticalOptions="Center" />
                        <Label Text="Hatırlatma ve kampanya e-postaları almak istiyorum." 
                               FontSize="11" 
                               TextColor="#666666" 
                               VerticalOptions="Center" 
                               LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>

                    <!-- Kayıt Butonu -->
                    <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,5,0,0" Padding="0">
                        <Button x:Name="RegisterButton" Text="KAYIT OL" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                    </Border>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>