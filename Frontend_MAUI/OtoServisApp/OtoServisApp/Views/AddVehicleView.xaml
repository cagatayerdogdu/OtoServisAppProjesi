<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.AddVehicleView"
             BackgroundColor="#F4F6F8"
             Title="Yeni Araç Ekle">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,30">
                <Label Text="Araç Bilgilerini Girin" FontSize="22" FontAttributes="Bold" TextColor="#333333" Margin="0,0,0,10"/>

                <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 15" Padding="25" Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.05" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Marka" TextColor="#666666" FontSize="13" FontAttributes="Bold"/>

                            <Border BackgroundColor="#F9F9F9" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                                <Button x:Name="SecilenMarkaButonu" Text="Lütfen marka seçin..." BackgroundColor="Transparent" TextColor="#888888" BorderWidth="0" Clicked="OnMarkaSecimButonuClicked" Margin="0" Padding="0"/>
                            </Border>

                            <Border x:Name="MarkaAramaKutusu" IsVisible="False" BackgroundColor="#F9F9F9" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,0">
                                <VerticalStackLayout Spacing="5">
                                    <SearchBar x:Name="MarkaAramaBar" Placeholder="Marka ara..." TextChanged="OnMarkaAramaDegisti" BackgroundColor="#FAFAFA" TextColor="#111111" CancelButtonColor="#D32F2F" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                                    <CollectionView x:Name="MarkaListesi" HeightRequest="200" SelectionMode="Single" SelectionChanged="OnMarkaSecildi">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout Padding="10">
                                                    <Label Text="{Binding ad, Mode=OneWay}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Model" TextColor="#666666" FontSize="13" FontAttributes="Bold"/>

                            <Border BackgroundColor="#F9F9F9" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                                <Button x:Name="SecilenModelButonu" Text="Önce marka seçmelisiniz" IsEnabled="False" BackgroundColor="Transparent" TextColor="#888888" BorderWidth="0" Clicked="OnModelSecimButonuClicked" Margin="0" Padding="0"/>
                            </Border>

                            <Border x:Name="ModelAramaKutusu" IsVisible="False" BackgroundColor="#F9F9F9" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,0">
                                <VerticalStackLayout Spacing="5">
                                    <SearchBar x:Name="ModelAramaBar" Placeholder="Model ara..." TextChanged="OnModelAramaDegisti" BackgroundColor="#FAFAFA" TextColor="#111111" CancelButtonColor="#D32F2F" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                                    <CollectionView x:Name="ModelListesi" HeightRequest="200" SelectionMode="Single" SelectionChanged="OnModelSecildi">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout Padding="10">
                                                    <Label Text="{Binding ad, Mode=OneWay}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Yakıt Tipi" TextColor="#666666" FontSize="13" FontAttributes="Bold"/>

                            <Border BackgroundColor="#F9F9F9" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                                <Button x:Name="SecilenYakitButonu" Text="Lütfen yakıt tipi seçin..." BackgroundColor="Transparent" TextColor="#888888" BorderWidth="0" Clicked="OnYakitSecimButonuClicked" Margin="0" Padding="0"/>
                            </Border>

                            <Border x:Name="YakitSecimKutusu" IsVisible="False" BackgroundColor="#F9F9F9" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,0">
                                <CollectionView x:Name="YakitListesi" HeightRequest="170" SelectionMode="Single" SelectionChanged="OnYakitSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="10">
                                                <Label Text="{Binding ., Mode=OneWay}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Üretim Yılı" TextColor="#666666" FontSize="13" FontAttributes="Bold"/>
                            <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                                <Entry x:Name="YearEntry" Keyboard="Numeric" MaxLength="4" Placeholder="Örn: 2020" PlaceholderColor="#888888" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Kilometre" TextColor="#666666" FontSize="13" FontAttributes="Bold"/>
                            <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
                                <Entry x:Name="KmEntry" Keyboard="Numeric" Placeholder="Örn: 45000" PlaceholderColor="#888888" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                            </Border>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,15,0,0" Padding="0">
                            <Button x:Name="SaveButton" Text="ARACI KAYDET" Clicked="OnSaveClicked" BackgroundColor="Transparent" TextColor="White" BorderWidth="0" FontSize="16" FontAttributes="Bold" Margin="0" Padding="0"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="ModernUyariEkrani" BackgroundColor="#80000000" IsVisible="False" ZIndex="999">
            <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="UyariMesaji" Text="İşlem Başarılı!" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />

                    <Border BackgroundColor="White" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="0">
                        <Button Text="Tamam" BackgroundColor="Transparent" TextColor="#00BCD4" BorderWidth="0" FontAttributes="Bold" Clicked="ModernUyariKapat_Clicked" Margin="0" Padding="0"/>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False" Grid.RowSpan="2">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Veriler Yükleniyor..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="Lütfen işlem bitene kadar bekleyiniz." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>