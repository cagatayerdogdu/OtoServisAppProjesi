<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             x:Class="OtoServisApp.Views.AdminServiceView"
             BackgroundColor="#F0F2F5"
             Title="Talepleri Yönet">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ÜST FİLTRE ÇUBUĞU -->
        <Border Grid.Row="0" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="10,10,10,5" ZIndex="1">
            <VerticalStackLayout Spacing="5">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                    <Grid WidthRequest="220" VerticalOptions="Center" HorizontalOptions="Start">
                        <SearchBar x:Name="AramaBar" Placeholder="Ad veya Araç..." TextChanged="OnFiltreDegisti" BackgroundColor="#FAFAFA" TextColor="#111111" Margin="30,0,0,0" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                        <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="14" TextColor="#888888" HorizontalOptions="Start" VerticalOptions="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                        <Label Text="Durum:" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="#333333"/>
                        <Border BackgroundColor="White" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 15" HeightRequest="35" WidthRequest="110" Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFiltreDurumKutusuAcKapatTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="SecilenDurumLabel" Text="Tümü" TextColor="#111111" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
                        </Border>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout HorizontalOptions="End" Padding="0,0,5,0">
                    <Label x:Name="ToplamTalepLabel" Text="0 talep" FontSize="11" TextColor="#666666" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- DURUM SEÇİM DROPDOWN'U -->
        <Border x:Name="DurumSecimKutusu" Grid.Row="0" Grid.RowSpan="3" IsVisible="False" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="0,60,15,0" ZIndex="99" HorizontalOptions="End" VerticalOptions="Start">
            <CollectionView x:Name="DurumListesi" HeightRequest="140" WidthRequest="110" SelectionMode="Single" SelectionChanged="OnFiltreDurumSecildi">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding ., Mode=OneWay}" FontSize="12" TextColor="#111111"/>
                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- TALEP LİSTESİ -->
        <CollectionView x:Name="RequestsList" Grid.Row="1" Margin="10">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Spacing="10" Margin="0,50,0,0">
                    <Label Text="{x:Static helpers:IconFont.ClipboardList}" FontFamily="FASolid" FontSize="50" TextColor="#BDC3C7" HorizontalOptions="Center" Opacity="0.6"/>
                    <Label Text="Gösterilecek Talep Yok" TextColor="#7F8C8D" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Arama kriterlerinizle eşleşen bir sonuç yok." TextColor="#95A5A6" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ServisTalebi">
                    <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <!-- Ana içerik iki sütunlu -->
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <!-- Ad Soyad -->
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="13" TextColor="#888888" VerticalOptions="Center"/>
                                        <Label Text="{Binding kullanici_ad_soyad, Mode=OneWay}" FontSize="15" FontAttributes="Bold" TextColor="#111111" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <!-- Tarih -->
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                        <Label Text="{Binding talep_tarihi, Mode=OneWay}" FontSize="12" TextColor="#666666" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <!-- Telefon -->
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static helpers:IconFont.Phone}" FontFamily="FASolid" FontSize="12" TextColor="#00BCD4" VerticalOptions="Center"/>
                                        <Label Text="{Binding kullanici_telefon, Mode=OneWay}" FontSize="12" FontAttributes="Bold" TextColor="#00BCD4" VerticalOptions="Center" TextDecorations="Underline">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPhoneTapped" CommandParameter="{Binding kullanici_telefon}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                    <!-- Araç -->
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="12" TextColor="#333333" VerticalOptions="Center"/>
                                        <Label Text="{Binding arac_adi_tam, Mode=OneWay}" FontSize="13" TextColor="#333333" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <!-- Hizmet -->
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static helpers:IconFont.Wrench}" FontFamily="FASolid" FontSize="12" TextColor="#00BCD4" VerticalOptions="Center"/>
                                        <Label Text="{Binding hizmet_adi, Mode=OneWay}" FontSize="13" TextColor="#00BCD4" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <!-- Müşteri Notu (kısa) -->
                                    <Label Text="{Binding notlar, Mode=OneWay}" FontSize="11" TextColor="#666666" LineBreakMode="TailTruncation" MaxLines="1"/>
                                    <!-- Düzeltme Talebi Uyarısı -->
                                    <Border IsVisible="{Binding duzeltme_istendi_mi, Mode=OneWay}" BackgroundColor="#FFEBEE" Stroke="#D32F2F" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,4" Margin="0,2,0,0">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="12" TextColor="#C62828" VerticalOptions="Center"/>
                                            <Label Text="Düzeltme talebi var" FontSize="11" TextColor="#C62828" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <!-- Adres (kopyalanabilir) -->
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static helpers:IconFont.MapMarkerAlt}" FontFamily="FASolid" FontSize="11" TextColor="#666666" VerticalOptions="Center"/>
                                        <Label Text="{Binding adres, Mode=OneWay}" FontSize="11" TextColor="#333333" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopyTapped" CommandParameter="{Binding adres}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Detay Butonu (ortada) -->
                                <Border Grid.Column="1" BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" WidthRequest="75" Padding="0" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDetayTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Detay" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" />
                                </Border>
                            </Grid>

                            <!-- Fotoğraf İkonu (sağ alt köşe) -->
                            <Label Text="{x:Static helpers:IconFont.Camera}" 
                                   FontFamily="FASolid" 
                                   FontSize="20" 
                                   TextColor="#FF9800" 
                                   HorizontalOptions="End" 
                                   VerticalOptions="End"
                                   Margin="0,0,2,2"
                                   IsVisible="{Binding foto_var_mi, Mode=OneWay}"
                                   InputTransparent="True" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- SAYFALAMA KONTROLLERİ -->
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="20" Padding="10,10">
            <Border BackgroundColor="#E0E6ED" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOncekiTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="BtnOncekiLabel" Text="&lt; Önceki" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,0" InputTransparent="True" />
            </Border>

            <Label x:Name="SayfaBilgiLabel" Text="Sayfa 1 / 1" VerticalOptions="Center" TextColor="#2C3E50" FontAttributes="Bold"/>

            <Border BackgroundColor="#E0E6ED" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSonrakiTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="BtnSonrakiLabel" Text="Sonraki &gt;" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,0" InputTransparent="True" />
            </Border>
        </HorizontalStackLayout>

        <!-- LOADING OVERLAY -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False" Grid.RowSpan="3">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Veriler Yükleniyor..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="Lütfen işlem bitene kadar bekleyiniz." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>