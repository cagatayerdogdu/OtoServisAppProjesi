<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.AdminShowcaseManageView"
             Title="Vitrin Yönetimi"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Üst Başlık ve Butonlar -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15" Spacing="10">
            <Label Text="Tamamlanan İşler" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50"/>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#00BCD4" StrokeShape="RoundRectangle 8" HeightRequest="45">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnYeniEkleTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="+ Yeni İş Ekle" TextColor="#FFFFFF" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#607D8B" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="15,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVitrineGitTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="👁 Vitrini Görüntüle" TextColor="#FFFFFF" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Liste -->
        <CollectionView Grid.Row="1" x:Name="VitrinListesi" Margin="15,5">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FFFFFF" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <!-- Küçük Resim -->
                            <Image Grid.Column="0" Source="{Binding TamResimUrl}" WidthRequest="60" HeightRequest="60" Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry Rect="0,0,60,60" CornerRadius="8"/>
                                </Image.Clip>
                            </Image>

                            <!-- Bilgiler -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Baslik}" FontAttributes="Bold" FontSize="16" TextColor="#2C3E50"/>
                                <Label Text="{Binding Etiket}" FontSize="13" TextColor="#00BCD4"/>
                                <Label Text="{Binding Tarih}" FontSize="12" TextColor="#7F8C8D"/>
                            </VerticalStackLayout>

                            <!-- Düzenle / Sil Butonları -->
                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                <Border BackgroundColor="#F39C12" StrokeShape="RoundRectangle 6" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDuzenleTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Düzenle" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold"/>
                                </Border>
                                <Border BackgroundColor="#E74C3C" StrokeShape="RoundRectangle 6" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSilTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Sil" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold"/>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Yükleme Overlay -->
        <Grid Grid.RowSpan="3" x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False">
            <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <ActivityIndicator IsRunning="True" Color="#00BCD4" />
                    <Label Text="İşlem Yapılıyor..." FontSize="16" TextColor="#333333"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Form Overlay (Arka plan tıklamalarını engeller) -->
        <Grid Grid.RowSpan="3" x:Name="FormOverlay" BackgroundColor="#80000000" IsVisible="False">
            <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" Padding="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="350">
                <ScrollView>
                    <VerticalStackLayout Spacing="15">
                        <Label x:Name="FormBaslik" Text="Yeni İş Ekle" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50"/>

                        <!-- Başlık -->
                        <Entry x:Name="BaslikEntry" Placeholder="Başlık (örn: BMW Seramik Kaplama)" PlaceholderColor="#95A5A6"/>

                        <!-- Açıklama -->
                        <Editor x:Name="AciklamaEditor" Placeholder="Açıklama" HeightRequest="80" PlaceholderColor="#95A5A6"/>

                        <!-- Etiket (Dropdown) -->
                        <Picker x:Name="EtiketPicker" Title="Etiket Seçin" TextColor="#2C3E50"/>

                        <!-- Tarih -->
                        <Entry x:Name="TarihEntry" Placeholder="Tarih (örn: Mart 2026)" PlaceholderColor="#95A5A6"/>

                        <!-- Fotoğraf Butonları -->
                        <HorizontalStackLayout Spacing="10">
                            <Button x:Name="GaleriButton" Text="📷 Galeriden Seç" Clicked="OnGaleridenSecClicked" BackgroundColor="#3498DB" TextColor="#FFFFFF"/>
                            <Button x:Name="KameraButton" Text="📸 Fotoğraf Çek" Clicked="OnKameraCekClicked" BackgroundColor="#2ECC71" TextColor="#FFFFFF"/>
                        </HorizontalStackLayout>

                        <!-- Seçilen Fotoğraf -->
                        <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="5" HeightRequest="150">
                            <Image x:Name="SecilenFotoImage" Aspect="AspectFill" BackgroundColor="#F8FAFC">
                                <Image.Clip>
                                    <RoundRectangleGeometry Rect="0,0,350,150" CornerRadius="8"/>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <!-- Kaydet / İptal -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Grid.Column="0" x:Name="KaydetButton" Text="Kaydet" Clicked="OnKaydetClicked" BackgroundColor="#00BCD4" TextColor="#FFFFFF" FontAttributes="Bold"/>
                            <Button Grid.Column="1" Text="İptal" Clicked="OnIptalClicked" BackgroundColor="#95A5A6" TextColor="#FFFFFF" FontAttributes="Bold"/>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>