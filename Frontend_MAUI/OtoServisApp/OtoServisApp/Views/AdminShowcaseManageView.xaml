<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.AdminShowcaseManageView"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             Title="Vitrin Yönetimi"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Üst Çubuk -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Padding="15" ColumnSpacing="10">
            <Label Grid.Column="0" Text="Tamamlanan İşler" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center"/>
            <Border Grid.Column="1" BackgroundColor="#00BCD4" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="15,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVitrineGitTapped"/>
                </Border.GestureRecognizers>
                <Label Text="👀 Vitrine Git" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#00BCD4" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="15,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnYeniEkleTapped"/>
                </Border.GestureRecognizers>
                <Label Text="+ Yeni İş Ekle" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Liste -->
        <CollectionView Grid.Row="1" x:Name="VitrinListesi" Margin="15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10" Margin="0,5">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                            <Image Grid.Column="0" Source="{Binding TamResimUrl}" WidthRequest="70" HeightRequest="70" Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry Rect="0,0,70,70" CornerRadius="10"/>
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Baslik}" FontAttributes="Bold" FontSize="16" TextColor="#2C3E50"/>
                                <Label Text="{Binding Etiket}" FontSize="12" TextColor="#00BCD4"/>
                                <Label Text="{Binding Tarih}" FontSize="12" TextColor="#7F8C8D"/>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                <Border BackgroundColor="#FF9800" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDuzenleTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Düzenle" TextColor="#FFFFFF" FontSize="12"/>
                                </Border>
                                <Border BackgroundColor="#FFEBEE" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSilTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Sil" TextColor="#D32F2F" FontSize="12"/>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Sayfalama -->
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="20" Padding="10">
            <Border BackgroundColor="#E0E6ED" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="15,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOncekiTapped"/>
                </Border.GestureRecognizers>
                <Label x:Name="BtnOncekiLabel" Text="&lt; Önceki" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>
            <Label x:Name="SayfaBilgiLabel" Text="Sayfa 1 / 1" VerticalOptions="Center" TextColor="#2C3E50" FontAttributes="Bold"/>
            <Border BackgroundColor="#E0E6ED" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="15,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSonrakiTapped"/>
                </Border.GestureRecognizers>
                <Label x:Name="BtnSonrakiLabel" Text="Sonraki &gt;" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>
        </HorizontalStackLayout>

        <!-- Form Popup -->
        <Grid x:Name="DuzenlemeFormu" Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="False">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="350">
                <ScrollView>
                    <VerticalStackLayout Spacing="15">
                        <Label Text="İş Ekle / Düzenle" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50"/>
                        <Entry x:Name="BaslikEntry" Placeholder="Başlık" TextColor="#2C3E50" BackgroundColor="#F8FAFC"/>
                        <Editor x:Name="AciklamaEditor" Placeholder="Açıklama" TextColor="#2C3E50" BackgroundColor="#F8FAFC" HeightRequest="80"/>
                        <Entry x:Name="TarihEntry" Placeholder="Tarih (örn: Nisan 2026)" TextColor="#2C3E50" BackgroundColor="#F8FAFC"/>
                        
                        <!-- <Picker x:Name="HizmetPicker" Title="Hizmet Seç (Etiket)" TextColor="#2C3E50" BackgroundColor="#F8FAFC"/>-->

                        <!-- Hizmet Seçimi (Aranabilir) -->
                        <VerticalStackLayout Spacing="5">
                            <!-- Seçili Hizmeti Gösteren Tıklanabilir Border -->
                            <Border x:Name="SecilenHizmetBorder" 
            BackgroundColor="#F8FAFC" 
            StrokeThickness="0" 
            StrokeShape="RoundRectangle 8" 
            HeightRequest="45" 
            Padding="15,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHizmetSecimTapped"/>
                                </Border.GestureRecognizers>
                                <Label x:Name="SecilenHizmetLabel" 
               Text="Hizmet Seçiniz" 
               TextColor="#2C3E50" 
               VerticalOptions="Center" 
               HorizontalOptions="Start"/>
                            </Border>

                            <!-- Arama ve Liste Popup'ı -->
                            <Grid x:Name="HizmetAramaKutusu" 
          IsVisible="False" 
          BackgroundColor="#FFFFFF" 
          RowDefinitions="Auto, *" 
          RowSpacing="5" 
          Padding="10" 
          Margin="0,5,0,0">
                                <Border Grid.Row="0" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC">
                                    <SearchBar x:Name="HizmetAramaBar" 
                       Placeholder="Hizmet ara..." TextColor="#2C3E50"
                       TextChanged="OnHizmetAramaDegisti" 
                       BackgroundColor="Transparent" 
                       CancelButtonColor="#D32F2F"/>
                                </Border>
                                <CollectionView Grid.Row="1" 
                        x:Name="HizmetListesi" 
                        HeightRequest="200" 
                        SelectionMode="Single" 
                        SelectionChanged="OnHizmetSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="10">
                                                <Label Text="{Binding ad}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                <Label Text="{Binding aciklama}" FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                                                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#3498DB" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGaleridenSecClicked"/>
                                </Border.GestureRecognizers>
                                <Label Text="📷 Galeriden Seç" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#2ECC71" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnKameraCekClicked"/>
                                </Border.GestureRecognizers>
                                <Label Text="📸 Fotoğraf Çek" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Image x:Name="SecilenFotoImage" HeightRequest="150" Aspect="AspectFill" BackgroundColor="Transparent">
                            <Image.Clip>
                                <RoundRectangleGeometry Rect="0,0,200,150" CornerRadius="10"/>
                            </Image.Clip>
                        </Image>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Border BackgroundColor="#00BCD4" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" WidthRequest="120">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnKaydetTapped"/>
                                </Border.GestureRecognizers>
                                <Label x:Name="KaydetLabel" Text="Kaydet" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Border BackgroundColor="#95A5A6" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" WidthRequest="120">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnIptalTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="İptal" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#80000000" IsVisible="False" Grid.RowSpan="3">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="30,20" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#00BCD4" WidthRequest="40" HeightRequest="40"/>
                    <Label x:Name="LoadingMessage" Text="İşlem Yapılıyor..." FontSize="16" TextColor="#2C3E50" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>