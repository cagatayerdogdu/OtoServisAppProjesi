<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.AdminShowcaseManageView"
             Title="Vitrin Yönetimi"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <!-- Üst Başlık ve Butonlar -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Tamamlanan İşler" FontSize="24" FontAttributes="Bold" TextColor="#1E293B" />
            <HorizontalStackLayout Spacing="10">
                <Border BackgroundColor="#00BCD4" StrokeShape="RoundRectangle 8" HeightRequest="50" HorizontalOptions="FillAndExpand">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnYeniEkleTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="+ Yeni İş Ekle" TextColor="#FFFFFF" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
                <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 8" HeightRequest="50" HorizontalOptions="End" WidthRequest="120">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVitrinGoruntuleTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="👁 Vitrini Gör" TextColor="#FFFFFF" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Liste (CollectionView) -->
        <CollectionView Grid.Row="1" x:Name="VitrinListesi" Margin="0,15" ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="Henüz vitrin öğesi eklenmemiş." FontSize="16" TextColor="#64748B"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                            <Image Grid.Column="0" Source="{Binding TamResimUrl}" WidthRequest="60" HeightRequest="60" Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry Rect="0,0,60,60" CornerRadius="10"/>
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Baslik}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Etiket}" FontSize="13" TextColor="#00BCD4" />
                                <Label Text="{Binding Tarih}" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                <Border BackgroundColor="#F59E0B" StrokeShape="RoundRectangle 6" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDuzenleTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Düzenle" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"/>
                                </Border>
                                <Border BackgroundColor="#EF4444" StrokeShape="RoundRectangle 6" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSilTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Sil" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"/>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Düzenleme / Ekleme Formu Overlay -->
        <Grid x:Name="DuzenlemeOverlay" BackgroundColor="#80000000" IsVisible="False" InputTransparent="False" Grid.RowSpan="3">
            <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="20" WidthRequest="350" HorizontalOptions="Center" VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="15">
                        <Label Text="{Binding FormBaslik}" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center"/>

                        <Entry x:Name="BaslikEntry" Placeholder="Başlık" PlaceholderColor="#94A3B8" TextColor="#1E293B" />
                        <Editor x:Name="AciklamaEditor" Placeholder="Açıklama" PlaceholderColor="#94A3B8" TextColor="#1E293B" HeightRequest="80" />
                        <Entry x:Name="EtiketEntry" Placeholder="Etiket (örn: ✨ Seramik Kaplama)" PlaceholderColor="#94A3B8" TextColor="#1E293B" />
                        <Entry x:Name="TarihEntry" Placeholder="Tarih (örn: Mart 2026)" PlaceholderColor="#94A3B8" TextColor="#1E293B" />

                        <HorizontalStackLayout Spacing="10">
                            <Button x:Name="GaleriButton" Text="📷 Galeriden Seç" Clicked="OnGaleridenSecClicked" BackgroundColor="#3B82F6" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="45" WidthRequest="150"/>
                            <Button x:Name="KameraButton" Text="📸 Fotoğraf Çek" Clicked="OnKameraCekClicked" BackgroundColor="#10B981" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="45" WidthRequest="150"/>
                        </HorizontalStackLayout>

                        <Image x:Name="SecilenFotoImage" HeightRequest="150" Aspect="AspectFill" BackgroundColor="#F1F5F9">
                            <Image.Clip>
                                <RoundRectangleGeometry Rect="0,0,300,150" CornerRadius="12"/>
                            </Image.Clip>
                        </Image>

                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                            <Button x:Name="KaydetButton" Text="Kaydet" Clicked="OnKaydetClicked" BackgroundColor="#00BCD4" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="45" WidthRequest="120"/>
                            <Button Text="İptal" Clicked="OnIptalClicked" BackgroundColor="#94A3B8" TextColor="#FFFFFF" CornerRadius="8" HeightRequest="45" WidthRequest="120"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#80000000" IsVisible="False" Grid.RowSpan="3">
            <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <ActivityIndicator IsRunning="True" Color="#00BCD4" HeightRequest="50" />
                    <Label Text="İşlem Yapılıyor..." FontSize="16" TextColor="#1E293B" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>