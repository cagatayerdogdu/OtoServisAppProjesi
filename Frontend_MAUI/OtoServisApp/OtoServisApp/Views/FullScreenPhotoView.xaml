<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.FullScreenPhotoView"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <CarouselView x:Name="FotoCarousel" 
                      Loop="True" 
                      IndicatorView="indicatorView">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <!-- ÇÖZÜM 1: Grid'e ClipToBounds ekleyerek zoom yapıldığında görselin taşmasını engelliyoruz -->
                    <Grid ClipToBounds="True">
                        <Image Source="{Binding TamUrl}" 
                               Aspect="AspectFit" 
                               HorizontalOptions="Fill" 
                               VerticalOptions="Fill">
                            <Image.GestureRecognizers>
                                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="indicatorView"
                       IndicatorColor="Grey"
                       SelectedIndicatorColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="End"
                       Margin="0,0,0,40" />

        <Button Text="X Kapat" 
                Clicked="OnKapatClicked" 
                BackgroundColor="#222222" 
                TextColor="White" 
                Opacity="0.8" 
                HorizontalOptions="End" 
                VerticalOptions="Start" 
                Margin="20,40,20,0" 
                CornerRadius="15"
                HeightRequest="40"
                Padding="15,0"
                FontAttributes="Bold"/>
    </Grid>
</ContentPage>