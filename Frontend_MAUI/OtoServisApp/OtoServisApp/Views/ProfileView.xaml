<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.ProfileView"
             BackgroundColor="#F4F6F8"
             Title="Hesabım">

    <ContentPage.Resources>
        <Style x:Key="CustomSwitchStyle" TargetType="Switch">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="On">
                            <VisualState.Setters>
                                <Setter Property="ThumbColor" Value="#0284C7" />
                                <Setter Property="OnColor" Value="#E0E0E0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Off">
                            <VisualState.Setters>
                                <Setter Property="ThumbColor" Value="#666666" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,30">

            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                <Label Grid.Column="0" Text="Profilim" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static helpers:IconFont.SignOut}" FontFamily="FASolid" FontSize="20" TextColor="#00BCD4" VerticalOptions="Center"/>
                    <Label Text="Çıkış" FontSize="14" FontAttributes="Bold" TextColor="#00BCD4" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <Label x:Name="ActivationAlertLabel" 
                   Text="Kullanıcı hesabınız pasif durumda! Lütfen yeni şifre belirleyerek hesabınızı aktif edin." 
                   TextColor="#D32F2F" 
                   BackgroundColor="#FFEBEE" 
                   Padding="12" 
                   Margin="0,0,0,5" 
                   IsVisible="False" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" />

            <Entry x:Name="YeniSifreEntry" 
                   Placeholder="Yeni Şifrenizi Giriniz" 
                   IsPassword="True" 
                   IsVisible="False" 
                   TextColor="#2C3E50" 
                   FontAttributes="Bold" 
                   BackgroundColor="White"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"/>

            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                        <Label Grid.Column="0" Text="Hesap Bilgileri" FontSize="16" FontAttributes="Bold" TextColor="#111111" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#00BCD4" WidthRequest="40" HeightRequest="40" Stroke="Transparent" StrokeShape="RoundRectangle 20" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="20" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Ad Soyad" TextColor="#888888" FontSize="12" FontAttributes="Bold"/>
                        <Entry x:Name="NameEntry" TextColor="#2C3E50" FontAttributes="Bold" BackgroundColor="#FAFAFA" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="E-Posta (Değiştirilemez)" TextColor="#888888" FontSize="12" FontAttributes="Bold"/>
                        <Entry x:Name="EmailEntry" IsEnabled="False" TextColor="#AAAAAA" BackgroundColor="#F5F5F5" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Telefon Numarası" TextColor="#888888" FontSize="12" FontAttributes="Bold"/>
                        <Entry x:Name="PhoneEntry" Keyboard="Telephone" TextColor="#2C3E50" FontAttributes="Bold" BackgroundColor="#FAFAFA" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Aracın Alınacağı Adres (Kendiniz getirecekseniz boş kalabilir)" TextColor="#888888" FontSize="12" FontAttributes="Bold"/>

                        <!-- Seçili Adresi Gösteren Tıklanabilir Alan -->
                        <Border x:Name="SecilenAdresBorder" BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="15,0" Margin="0,0,0,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAdresSecimTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="SecilenAdresLabel" Text="Adres Seçiniz..." TextColor="#2C3E50" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                        </Border>

                        <!-- Adres Seçim Paneli (Başlangıçta gizli) -->
                        <Grid x:Name="AdresSecimPaneli" IsVisible="False" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10" Margin="0,10,0,10">

                            <!-- 0. İl (Sabit) -->
                            <Border Grid.Row="0" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F5F5F5" Padding="15,5">
                                <Label Text="İl: İstanbul" TextColor="#2C3E50" FontAttributes="Bold"/>
                            </Border>

                            <!-- 1. API Hata Paneli (Başlangıçta gizli) -->
                            <VerticalStackLayout x:Name="ApiHataPaneli" Grid.Row="1" IsVisible="False" Spacing="10">
                                <Border BackgroundColor="#FFEBEE" Stroke="#D32F2F" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                                    <Label x:Name="ApiHataMesaji" Text="Adres servisine şu anda erişilemiyor. Lütfen adres bilgilerinizi aşağıya manuel olarak giriniz." 
                   TextColor="#D32F2F" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                </Border>
                                <Entry x:Name="ManuelIlceEntry" Placeholder="İlçe" BackgroundColor="#FAFAFA" TextColor="#2C3E50"/>
                                <Entry x:Name="ManuelMahalleEntry" Placeholder="Mahalle" BackgroundColor="#FAFAFA" TextColor="#2C3E50"/>
                            </VerticalStackLayout>

                            <!-- 2. İlçe Seçimi (Normal mod) -->
                            <VerticalStackLayout x:Name="IlceSecimStack" Grid.Row="1" Spacing="5">
                                <Label Text="İlçe" TextColor="#888888" FontSize="12"/>
                                <Border x:Name="SecilenIlceBorder" BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="15,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnIlceSecimTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="SecilenIlceLabel" Text="İlçe Seçiniz..." TextColor="#2C3E50" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- İlçe Listesi Popup -->
                            <Grid x:Name="IlceListesiPopup" Grid.Row="1" IsVisible="False" BackgroundColor="White" RowDefinitions="Auto, *" Margin="0,50,0,0" HeightRequest="300">
                                <Border Grid.Row="0" BackgroundColor="#00BCD4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="İlçe Seçiniz" TextColor="White" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="✕" TextColor="White" FontSize="18" HorizontalOptions="End" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnIlcePopupKapatTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                                <CollectionView Grid.Row="1" x:Name="IlceListesi" SelectionMode="Single" SelectionChanged="OnIlceSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="15,10">
                                                <Label Text="{Binding Name}" FontSize="16" TextColor="#2C3E50"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                            <!-- 3. Mahalle Seçimi (Normal mod) -->
                            <VerticalStackLayout x:Name="MahalleSecimStack" Grid.Row="2" Spacing="5">
                                <Label Text="Mahalle" TextColor="#888888" FontSize="12"/>
                                <Border x:Name="SecilenMahalleBorder" BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" Padding="15,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMahalleSecimTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="SecilenMahalleLabel" Text="Mahalle Seçiniz..." TextColor="#2C3E50" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Mahalle Listesi Popup -->
                            <Grid x:Name="MahalleListesiPopup" Grid.Row="2" IsVisible="False" BackgroundColor="White" RowDefinitions="Auto, *" Margin="0,50,0,0" HeightRequest="300">
                                <Border Grid.Row="0" BackgroundColor="#00BCD4" Padding="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="Mahalle Seçiniz" TextColor="White" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="✕" TextColor="White" FontSize="18" HorizontalOptions="End" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMahallePopupKapatTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                                <CollectionView Grid.Row="1" x:Name="MahalleListesi" SelectionMode="Single" SelectionChanged="OnMahalleSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="15,10">
                                                <Label Text="{Binding Name}" FontSize="16" TextColor="#2C3E50"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                            <!-- 4. Sokak / Cadde (Manuel Giriş) -->
                            <VerticalStackLayout Grid.Row="3" Spacing="5">
                                <Label Text="Cadde / Sokak" TextColor="#888888" FontSize="12"/>
                                <Entry x:Name="SokakEntry" Placeholder="Örn: Fatih Sultan Mehmet Caddesi" BackgroundColor="#FAFAFA" TextColor="#2C3E50"/>
                            </VerticalStackLayout>

                            <!-- 5. Apartman / No (Manuel Giriş) -->
                            <VerticalStackLayout Grid.Row="4" Spacing="5">
                                <Label Text="No" TextColor="#888888" FontSize="12"/>
                                <Entry x:Name="AptNoEntry" Placeholder="Örn: No.34" BackgroundColor="#FAFAFA" TextColor="#2C3E50"/>
                            </VerticalStackLayout>

                            <!-- 6. Kaydet Butonu -->
                            <Border Grid.Row="5" BackgroundColor="#00BCD4" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="45" Margin="0,10,0,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAdresKaydetTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Adresi Kaydet" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="45" Margin="0,10,0,0" Padding="0">
                        <Button x:Name="UpdateButton" Text="BİLGİLERİMİ GÜNCELLE" Clicked="OnUpdateClicked" BackgroundColor="Transparent" TextColor="#FAFAFA" FontSize="14" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Tercihler" FontSize="16" FontAttributes="Bold" TextColor="#111111" Margin="0,0,0,5"/>

                    <!--<Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" HeightRequest="45">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center" InputTransparent="True">
                            <Label Text="{x:Static helpers:IconFont.Moon}" FontFamily="FASolid" FontSize="18" TextColor="#3F51B5" VerticalOptions="Center"/>
                            <Label Text="Karanlık Mod (Yakında)" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Switch x:Name="ThemeSwitch" Grid.Column="1" Toggled="OnThemeSwitchToggled" VerticalOptions="Center" HorizontalOptions="End" Style="{StaticResource CustomSwitchStyle}" />
                    </Grid> -->

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" HeightRequest="45">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2" InputTransparent="True">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{x:Static helpers:IconFont.Envelope}" FontFamily="FASolid" FontSize="16" TextColor="#3498DB" VerticalOptions="Center"/>
                                <Label Text="E-posta Bildirimleri" FontSize="14" FontAttributes="Bold" TextColor="#334155"/>
                            </HorizontalStackLayout>
                            <Label Text="Hatırlatma e-postaları almak istiyorum." FontSize="11" TextColor="#64748B" Margin="26,0,0,0"/>
                        </VerticalStackLayout>

                        <Switch x:Name="MailIzniSwitch" Grid.Column="1" Toggled="OnMailIzniToggled" VerticalOptions="Center" HorizontalOptions="End" Style="{StaticResource CustomSwitchStyle}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12" Margin="0,10,0,20">

                <Grid x:Name="AdminPanelButton" HeightRequest="50" IsVisible="False">
                    <Border BackgroundColor="#2C3E50" StrokeShape="RoundRectangle 12" Padding="0" Stroke="Transparent">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                            <Label Text="{x:Static helpers:IconFont.Crown}" FontFamily="FASolid" FontSize="18" TextColor="#FAFAFA" VerticalOptions="Center"/>
                            <Label Text="YÖNETİM PANELİ" FontSize="14" FontAttributes="Bold" TextColor="#FAFAFA" VerticalOptions="Center"/>
                            <Label Text="{x:Static helpers:IconFont.Crown}" FontFamily="FASolid" FontSize="18" TextColor="#FAFAFA" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Button BackgroundColor="Transparent" Clicked="OnAdminPanelClicked" />
                </Grid>

                <Border BackgroundColor="Transparent" Stroke="#0284C7" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" HeightRequest="45" Padding="0">
                    <Button x:Name="ChangePasswordButton" Text="Şifremi Değiştir" BackgroundColor="Transparent" TextColor="#0284C7" FontAttributes="Bold" Clicked="OnChangePasswordClicked" BorderWidth="0" Margin="0" Padding="0"/>
                </Border>

                <Border BackgroundColor="Transparent" Stroke="#D32F2F" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" HeightRequest="45" Padding="0">
                    <Button x:Name="DeleteAccountButton" Text="Hesabımı Sil" BackgroundColor="Transparent" TextColor="#D32F2F" FontAttributes="Bold" Clicked="OnHesapSilClicked" BorderWidth="0" Margin="0" Padding="0"/>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>