<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.ProfileView"
             BackgroundColor="#F4F6F8"
             Title="Hesabım">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,30">

            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <Label Grid.Column="0" Text="Profil Bilgileri" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static helpers:IconFont.SignOut}" FontFamily="FASolid" FontSize="20" TextColor="#00BCD4" VerticalOptions="Center"/>
                    <Label Text="Çıkış" FontSize="14" FontAttributes="Bold" TextColor="#00BCD4" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 15" Padding="25" Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label Text="Ad Soyad" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Entry x:Name="NameEntry" TextColor="#2C3E50" FontAttributes="Bold"/>

                    <Label Text="E-Posta (Değiştirilemez)" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Entry x:Name="EmailEntry" IsEnabled="False" TextColor="#AAAAAA"/>

                    <Label Text="Telefon" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Entry x:Name="PhoneEntry" Keyboard="Telephone" TextColor="#2C3E50" FontAttributes="Bold"/>

                    <Label Text="Adres" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Editor x:Name="AddressEditor" TextColor="#2C3E50" FontAttributes="Bold" HeightRequest="80" AutoSize="TextChanges" BackgroundColor="Transparent" />

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                    <Button x:Name="UpdateButton" Text="BİLGİLERİMİ GÜNCELLE" Clicked="OnUpdateClicked" BackgroundColor="#00BCD4" TextColor="#FAFAFA" CornerRadius="8" HeightRequest="50" FontSize="16" FontAttributes="Bold" Margin="0,5,0,0"/>

                    <Grid x:Name="AdminPanelButton" Margin="0,15,0,0" HeightRequest="50" IsVisible="False">
                        <Border BackgroundColor="#2C3E50" StrokeShape="RoundRectangle 8" Padding="0" Stroke="Transparent">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:IconFont.Crown}" FontFamily="FASolid" FontSize="18" TextColor="#FAFAFA" VerticalOptions="Center"/>
                                <Label Text="YÖNETİM PANELİ" FontSize="15" FontAttributes="Bold" TextColor="#FAFAFA" VerticalOptions="Center"/>
                                <Label Text="{x:Static helpers:IconFont.Crown}" FontFamily="FASolid" FontSize="18" TextColor="#FAFAFA" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                        <Button BackgroundColor="Transparent" Clicked="OnAdminPanelClicked" />
                    </Grid>

                    <Button Text="Şifremi Değiştir" BackgroundColor="Transparent" TextColor="#2C3E50" BorderColor="#2C3E50" BorderWidth="1.5" CornerRadius="8" Margin="0,5,0,0" HeightRequest="50" FontAttributes="Bold" Clicked="OnChangePasswordClicked" />

                    <Button Text="Hesabımı Sil" BackgroundColor="Transparent" TextColor="#D32F2F" BorderColor="#D32F2F" BorderWidth="1.5" CornerRadius="8" Margin="0,5,0,0" HeightRequest="50" FontAttributes="Bold" Clicked="OnHesapSilClicked" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>