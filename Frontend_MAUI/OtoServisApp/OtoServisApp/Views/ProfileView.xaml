<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.ProfileView"
             BackgroundColor="#F4F6F8"
             Title="Hesabım">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,30">

            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <Label Grid.Column="0" Text="Profil Bilgileri" FontSize="24" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static helpers:IconFont.SignOut}" FontFamily="FASolid" FontSize="20" TextColor="#00BCD4" VerticalOptions="Center"/>
                    <Label Text="Çıkış" FontSize="14" FontAttributes="Bold" TextColor="#00BCD4" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,10,0,20">
                <Grid ColumnDefinitions="*, Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="{x:Static helpers:IconFont.Moon}" FontFamily="FASolid" FontSize="18" TextColor="#333333" VerticalOptions="Center"/>
                        <Label Text="Karanlık Mod" FontSize="16" TextColor="#333333" VerticalOptions="Center" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Switch x:Name="ThemeSwitch" Grid.Column="1" Toggled="OnThemeSwitchToggled" OnColor="#00BCD4" VerticalOptions="Center" HorizontalOptions="End" />
                </Grid>
            </Border>

            <Label Text="Bildirim Ayarları" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="5,15,0,5"/>

            <Frame BackgroundColor="White" BorderColor="#E2E8F0" CornerRadius="12" Padding="15" HasShadow="False">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                        <Label Text="E-posta Bildirimleri" FontSize="15" FontAttributes="Bold" TextColor="#334155"/>
                        <Label Text="Hatırlatma ve kampanya e-postaları almak istiyorum." FontSize="12" TextColor="#64748B"/>
                    </VerticalStackLayout>
                    <Switch x:Name="MailIzniSwitch" Grid.Column="1" VerticalOptions="Center" OnColor="#3498DB" Scale="0.9" Toggled="OnMailIzniToggled">
                        <Switch.Triggers>
                            <DataTrigger TargetType="Switch" Binding="{Binding Source={x:Reference MailIzniSwitch}, Path=IsToggled}" Value="True">
                                <Setter Property="ThumbColor" Value="#25D366" />
                            </DataTrigger>
                            <DataTrigger TargetType="Switch" Binding="{Binding Source={x:Reference MailIzniSwitch}, Path=IsToggled}" Value="False">
                                <Setter Property="ThumbColor" Value="#666666" />
                            </DataTrigger>
                        </Switch.Triggers>
                    </Switch>
                </Grid>
            </Frame>

            <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 15" Padding="25" Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <Label x:Name="ActivationAlertLabel" 
                           Text="Kullanıcı hesabınız pasif durumda! Lütfen yeni şifre belirleyerek hesabınızı aktif edin." 
                           TextColor="#D32F2F" 
                           BackgroundColor="#FFEBEE" 
                           Padding="10" 
                           Margin="0,0,0,10" 
                           IsVisible="False" 
                           FontAttributes="Bold" 
                           HorizontalTextAlignment="Center" />

                    <Label Text="Ad Soyad" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Entry x:Name="NameEntry" TextColor="#2C3E50" FontAttributes="Bold"/>

                    <Label Text="E-Posta (Değiştirilemez)" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Entry x:Name="EmailEntry" IsEnabled="False" TextColor="#AAAAAA"/>

                    <Entry x:Name="YeniSifreEntry" 
                           Placeholder="Yeni Şifrenizi Giriniz" 
                           IsPassword="True" 
                           IsVisible="False" 
                           TextColor="#2C3E50" 
                           FontAttributes="Bold" />

                    <Label Text="Telefon" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Entry x:Name="PhoneEntry" Keyboard="Telephone" TextColor="#2C3E50" FontAttributes="Bold"/>

                    <Label Text="Adres" TextColor="#888888" FontSize="13" Margin="0,0,0,-10"/>
                    <Editor x:Name="AddressEditor" TextColor="#2C3E50" FontAttributes="Bold" HeightRequest="80" AutoSize="TextChanges" BackgroundColor="Transparent" />

                    <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                    <Button x:Name="UpdateButton" Text="BİLGİLERİMİ GÜNCELLE" Clicked="OnUpdateClicked" BackgroundColor="#00BCD4" TextColor="#FAFAFA" CornerRadius="8" HeightRequest="50" FontSize="16" FontAttributes="Bold" Margin="0,5,0,0"/>

                    <Grid x:Name="AdminPanelButton" Margin="0,15,0,0" HeightRequest="50" IsVisible="False">
                        <Border BackgroundColor="#2C3E50" StrokeShape="RoundRectangle 8" Padding="0" Stroke="Transparent">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:IconFont.Crown}" FontFamily="FASolid" FontSize="18" TextColor="#FAFAFA" VerticalOptions="Center"/>
                                <Label Text="YÖNETİM PANELİ" FontSize="15" FontAttributes="Bold" TextColor="#FAFAFA" VerticalOptions="Center"/>
                                <Label Text="{x:Static helpers:IconFont.Crown}" FontFamily="FASolid" FontSize="18" TextColor="#FAFAFA" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                        <Button BackgroundColor="Transparent" Clicked="OnAdminPanelClicked" />
                    </Grid>

                    <Button x:Name="ChangePasswordButton" Text="Şifremi Değiştir" BackgroundColor="Transparent" TextColor="#0284C7" BorderColor="#0284C7" BorderWidth="1.5" CornerRadius="8" Margin="0,5,0,0" HeightRequest="50" FontAttributes="Bold" Clicked="OnChangePasswordClicked" />

                    <Button x:Name="DeleteAccountButton" Text="Hesabımı Sil" BackgroundColor="Transparent" TextColor="#D32F2F" BorderColor="#D32F2F" BorderWidth="1.5" CornerRadius="8" Margin="0,5,0,0" HeightRequest="50" FontAttributes="Bold" Clicked="OnHesapSilClicked" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>