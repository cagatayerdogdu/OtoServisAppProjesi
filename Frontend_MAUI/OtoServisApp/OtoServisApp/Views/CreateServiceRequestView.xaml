<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.CreateServiceRequestView"
             BackgroundColor="#F4F6F8"
             Title="Servis Talebi Oluştur">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,15,20,30">

                <Border BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="20" Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.05" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <Label Text="Hangi Aracınız İçin?" TextColor="#666666" FontSize="13" FontAttributes="Bold" />

                        <Border BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                            <Button x:Name="SecilenAracButonu" Text="Lütfen bir araç seçin..." BackgroundColor="Transparent" TextColor="#666666" BorderWidth="0" Clicked="OnAracSecimButonuClicked" Margin="0" Padding="0"/>
                        </Border>

                        <Border x:Name="AracAramaKutusu" IsVisible="False" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,10">
                            <VerticalStackLayout Spacing="5">
                                <CollectionView x:Name="AracListesi" HeightRequest="150" SelectionMode="Single" SelectionChanged="OnAracSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="10">
                                                <Label Text="{Binding marka_model_yazi}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                <Label Text="{Binding yil, StringFormat='{0} Model'}" FontSize="11" TextColor="#888888"/>
                                                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Almak İstediğiniz Hizmet" TextColor="#666666" FontSize="13" FontAttributes="Bold" />

                        <Border BackgroundColor="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="45" HorizontalOptions="FillAndExpand" Padding="0">
                            <Button x:Name="SecilenHizmetButonu" Text="Lütfen bir hizmet seçin..." BackgroundColor="Transparent" TextColor="#666666" BorderWidth="0" Clicked="OnHizmetSecimButonuClicked" Margin="0" Padding="0"/>
                        </Border>

                        <Border x:Name="HizmetAramaKutusu" IsVisible="False" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,10">
                            <VerticalStackLayout Spacing="5">
                                <SearchBar x:Name="HizmetAramaBar" Placeholder="Hizmet ara... (Örn: Fren, Yağ)" TextChanged="OnHizmetAramaDegisti" BackgroundColor="#F9F9F9" TextColor="#111111" CancelButtonColor="#D32F2F" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>

                                <CollectionView x:Name="HizmetListesi" HeightRequest="200" SelectionMode="Single" SelectionChanged="OnHizmetSecildi">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Padding="10">
                                                <Label Text="{Binding ad}" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                                <Label Text="{Binding aciklama}" FontSize="11" TextColor="#888888" LineBreakMode="WordWrap"/>
                                                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Randevu Tarihi" TextColor="#666666" FontSize="13" FontAttributes="Bold" />
                            <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 8" Padding="15,5">
                                <DatePicker x:Name="RequestDatePicker" MinimumDate="{Binding Source={x:Static x:DateTime.Today}}" TextColor="#111111" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Araç Nereden Alınacak? (Adres)" TextColor="#666666" FontSize="13" FontAttributes="Bold" />
                            <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 8" Padding="15,5">
                                <Editor x:Name="AddressEditor" Placeholder="Açık adresinizi giriniz..." PlaceholderColor="#888888" TextColor="#111111" BackgroundColor="Transparent" HeightRequest="80" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ek Notlar (İsteğe Bağlı)" TextColor="#666666" FontSize="13" FontAttributes="Bold" />
                            <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 8" Padding="15,5">
                                <Editor x:Name="NotesEditor" Placeholder="Ustaya iletmek istediğiniz detaylar..." PlaceholderColor="#888888" TextColor="#111111" BackgroundColor="Transparent" HeightRequest="60" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:IconFont.Camera}" FontFamily="FASolid" FontSize="16" TextColor="#666666" VerticalOptions="Center"/>
                                <Label Text="Hasar Fotoğrafları (Maks 4)" TextColor="#666666" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Border BackgroundColor="#E0F2F1" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Margin="0,0,0,5" Padding="0">
                                <Button Text="+ Fotoğrafları Seç (Toplu)" Clicked="OnAddPhotoClicked" BackgroundColor="Transparent" TextColor="#00796B" BorderWidth="0" Margin="0" Padding="0"/>
                            </Border>

                            <FlexLayout x:Name="PhotosContainer" BindableLayout.ItemsSource="{Binding SecilenFotograflar}" Wrap="Wrap" JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid WidthRequest="80" HeightRequest="80" Margin="0,0,10,10">
                                            <Image Source="{Binding FullPath}" Aspect="AspectFill" WidthRequest="80" HeightRequest="80"/>
                                            <Border BackgroundColor="#EF4444" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="25" HeightRequest="25" HorizontalOptions="End" VerticalOptions="Start" Margin="3" Padding="0">
                                                <Button Text="X" CommandParameter="{Binding .}" Clicked="OnRemovePhotoClicked" BackgroundColor="Transparent" TextColor="White" BorderWidth="0" FontSize="10" FontAttributes="Bold" Margin="0" Padding="0"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,15,0,0" Padding="0">
                            <Button x:Name="SubmitButton" Text="TALEBİ OLUŞTUR" Clicked="OnSubmitClicked" BackgroundColor="Transparent" TextColor="White" FontSize="16" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Lütfen Bekleyiniz..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="İşleminiz gerçekleştiriliyor." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>