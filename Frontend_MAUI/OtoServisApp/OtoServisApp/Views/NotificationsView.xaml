<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             x:Class="OtoServisApp.Views.NotificationsView"
             BackgroundColor="#F4F6F8"
             Title="Bildirimlerim">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ÜST ÇUBUK: Seçim ve Toplam Sayı -->
        <Border Grid.Row="0" BackgroundColor="#F8FAFC" Padding="15,10" StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <CheckBox x:Name="ChkSelectAll" CheckedChanged="OnSelectAllCheckedChanged" Color="#00BCD4"/>
                    <Label Text="Hepsini Seç" FontAttributes="Bold" VerticalOptions="Center" TextColor="#334155"/>
                </HorizontalStackLayout>

                <Label Grid.Column="1" x:Name="ToplamBildirimLabel" Text="0 bildirim" FontSize="12" TextColor="#666666" VerticalOptions="Center" Margin="0,0,15,0"/>

                <Border Grid.Column="2" BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="35" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteSelectedTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="BtnDeleteSelectedLabel" Text="Seçilenleri Sil" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,0" InputTransparent="True" IsVisible="False"/>
                </Border>
            </Grid>
        </Border>

        <!-- BİLDİRİM LİSTESİ -->
        <CollectionView Grid.Row="1" x:Name="NotificationList" Margin="15"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReached="OnThresholdReached">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,100,0,0">
                    <Label Text="{x:Static helpers:IconFont.Bell}" FontFamily="FASolid" FontSize="50" TextColor="#888888" HorizontalOptions="Center" Opacity="0.5"/>
                    <Label Text="Henüz yeni bir bildiriminiz yok." TextColor="#888888" FontSize="16"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BildirimResponse">
                    <Grid Padding="0,0,0,10">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItemView CommandParameter="{Binding .}" Invoked="OnSingleDeleteInvoked">
                                    <Border BackgroundColor="#EF4444" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="20" Margin="10,0,0,0" WidthRequest="70">
                                        <Label Text="{x:Static helpers:IconFont.Trash}" FontFamily="FASolid" FontSize="20" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    </Border>
                                </SwipeItemView>
                            </SwipeView.RightItems>

                            <Border x:Name="CardBorder" StrokeShape="RoundRectangle 12" Padding="15" StrokeThickness="1.5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationTapped" NumberOfTapsRequired="1" />
                                </Border.GestureRecognizers>

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="White" />
                                        <Setter Property="Stroke" Value="Transparent" />

                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding okundu_mu}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#F0F9FF" />
                                                <Setter Property="Stroke" Value="#0284C7" />
                                            </DataTrigger>

                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#E8F5E9" />
                                                <Setter Property="Stroke" Value="#4CAF50" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid ColumnDefinitions="Auto, *">
                                    <CheckBox Grid.Column="0" 
                                      IsChecked="{Binding IsSelected}" 
                                      Color="#00BCD4" 
                                      VerticalOptions="Center"
                                      CheckedChanged="OnItemCheckChanged"/>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{x:Static helpers:IconFont.Bell}" FontFamily="FASolid" FontSize="16" TextColor="#00BCD4" VerticalOptions="Center"/>
                                            <Label Text="{Binding baslik}" FontSize="15" TextColor="#111111" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding okundu_mu}" Value="False">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                        <Setter Property="TextColor" Value="#0284C7" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding mesaj}" FontSize="13" TextColor="#555555" />
                                        <Label Text="{Binding olusturulma_tarihi, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="11" TextColor="#888888" HorizontalOptions="End" Margin="0,5,0,0"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- SAYFALAMA KONTROLLERİ -->
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="20" Padding="10,10">
            <Border BackgroundColor="#E0E6ED" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOncekiTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="BtnOncekiLabel" Text="&lt; Önceki" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,0" InputTransparent="True" />
            </Border>

            <Label x:Name="SayfaBilgiLabel" Text="Sayfa 1 / 1" VerticalOptions="Center" TextColor="#2C3E50" FontAttributes="Bold"/>

            <Border BackgroundColor="#E0E6ED" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSonrakiTapped" />
                </Border.GestureRecognizers>
                <Label x:Name="BtnSonrakiLabel" Text="Sonraki &gt;" TextColor="#2C3E50" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,0" InputTransparent="True" />
            </Border>
        </HorizontalStackLayout>

        <!-- LOADING OVERLAY -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False" Grid.RowSpan="3">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Bildirimler Yükleniyor..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="Lütfen işlem bitene kadar bekleyiniz." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>