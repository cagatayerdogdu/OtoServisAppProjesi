<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.NotificationsView"
             BackgroundColor="#F4F6F8"
             Title="Bildirimlerim">

    <Grid>
        <CollectionView x:Name="NotificationsList" Margin="15">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,100,0,0">
                    <Label Text="{x:Static helpers:IconFont.Bell}" FontFamily="FASolid" FontSize="50" TextColor="#888888" HorizontalOptions="Center" Opacity="0.5"/>
                    <Label Text="Henüz yeni bir bildiriminiz yok." TextColor="#888888" FontSize="16"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,0,0,10">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding okundu_mu}" Value="False">
                                <Setter Property="BackgroundColor" Value="#E0F7FA" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding okundu_mu}" Value="True">
                                <Setter Property="BackgroundColor" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{x:Static helpers:IconFont.Bell}" FontFamily="FASolid" FontSize="16" TextColor="#00BCD4" VerticalOptions="Center"/>
                                <Label Text="{Binding baslik}" FontSize="15" FontAttributes="Bold" TextColor="#111111" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Label Text="{Binding mesaj}" FontSize="13" TextColor="#555555" Margin="26,0,0,0"/>

                            <Label Text="{Binding olusturulma_tarihi, StringFormat='{0:dd.MM.yyyy HH:mm}'}" FontSize="11" TextColor="#888888" HorizontalOptions="End" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>