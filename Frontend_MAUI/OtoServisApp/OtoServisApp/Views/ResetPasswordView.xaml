<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.ResetPasswordView"
             BackgroundColor="#F4F6F8"
             Title="Yeni Şifre Belirle">

    <VerticalStackLayout Spacing="20" Padding="30,50">
        <Label Text="Yeni Şifrenizi Girin" FontSize="24" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
        <Label Text="Hesabınız için yeni ve güvenli bir şifre oluşturun." TextColor="#666666" HorizontalOptions="Center" Margin="0,-10,0,10"/>

        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#EAEAEA" StrokeShape="RoundRectangle 8" Padding="15,5">
            <Entry x:Name="EmailEntry" IsEnabled="False" TextColor="#888888" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
        </Border>

        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
            <Entry x:Name="NewPasswordEntry" Placeholder="Yeni Şifreniz" IsPassword="True" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
        </Border>

        <Border Stroke="#CCCCCC" StrokeThickness="1.5" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 8" Padding="15,5">
            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Yeni Şifreniz (Tekrar)" IsPassword="True" TextColor="#111111" BackgroundColor="Transparent" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"/>
        </Border>

        <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="50" Margin="0,10,0,0" Padding="0">
            <Button x:Name="SaveButton" Text="ŞİFREYİ GÜNCELLE" Clicked="OnSaveClicked" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" BorderWidth="0" Margin="0" Padding="0"/>
        </Border>
    </VerticalStackLayout>
</ContentPage>