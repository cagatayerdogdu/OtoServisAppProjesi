<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.ShowcaseView"
             BackgroundColor="#111111"
             Title="Vitrinimiz">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Padding="20,20,20,0" Opacity="0" x:Name="HeaderAnim" ZIndex="1">
            <Label Text="Premium İşçilik" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
            <Label Text="Kapıdan bakımın sanatla buluştuğu anlar." FontSize="14" TextColor="#A0A0A0" HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CarouselView Grid.Row="1" x:Name="ShowcaseCarousel" IndicatorView="Indicator" Margin="0,15,0,0" Loop="False" PeekAreaInsets="20" PositionChanged="OnPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <ContentView Padding="10">
                        <Border Stroke="Transparent" StrokeShape="RoundRectangle 25">
                            <Grid>
                                <Image Source="{Binding ResimSource, Mode=OneWay}" Aspect="AspectFill" />

                                <BoxView VerticalOptions="End" HeightRequest="250">
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Transparent" Offset="0.0" />
                                            <GradientStop Color="#E6000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>

                                <VerticalStackLayout VerticalOptions="End" Padding="20,20,20,60" Spacing="8">
                                    <Border BackgroundColor="#00BCD4" Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="12,6" HorizontalOptions="Start" Margin="0,0,0,5">
                                        <Label Text="{Binding Etiket}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                                    </Border>

                                    <Label Text="{Binding Baslik}" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" />
                                    <Label Text="{Binding Aciklama}" FontSize="14" TextColor="#CCCCCC" LineBreakMode="WordWrap" />

                                    <HorizontalStackLayout Spacing="5" Margin="0,10,0,0">
                                        <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                        <Label Text="{Binding Tarih}" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView Grid.Row="2" x:Name="Indicator" HorizontalOptions="Center" IndicatorColor="#444444" SelectedIndicatorColor="#00BCD4" Margin="0,10,0,20"/>
    </Grid>
</ContentPage>