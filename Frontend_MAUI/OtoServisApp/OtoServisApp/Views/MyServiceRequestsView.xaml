<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.MyServiceRequestsView"
             BackgroundColor="#F4F6F8"
             Title="Servis Taleplerim">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="10,10,10,5">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Filtrele:" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="#333333"/>
                <VerticalStackLayout>
                    <Button x:Name="SecilenDurumButonu" Text="Tümü" BackgroundColor="White" TextColor="#111111" BorderColor="#CCCCCC" BorderWidth="1" CornerRadius="15" HeightRequest="35" WidthRequest="120" FontSize="12" Clicked="OnFiltreAcKapat" />
                    <Border x:Name="DurumSecimKutusu" IsVisible="False" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="0,5,0,0" ZIndex="99">
                        <CollectionView x:Name="DurumListesi" HeightRequest="180" WidthRequest="120" SelectionMode="Single" SelectionChanged="OnFiltreSecildi">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Padding="10" FontSize="12" TextColor="#111111"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <CollectionView x:Name="RequestsList" Grid.Row="1" Margin="20">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,100,0,0">
                    <Label Text="{x:Static helpers:IconFont.ClipboardList}" FontFamily="FASolid" FontSize="50" TextColor="#888888" HorizontalOptions="Center" Opacity="0.5"/>
                    <Label Text="Henüz bir servis talebiniz bulunmuyor." TextColor="#888888" FontSize="16"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20" Margin="0,0,0,15">
                        <VerticalStackLayout Spacing="10">

                            <VerticalStackLayout Spacing="5" Margin="0,0,0,5">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.Wrench}" FontFamily="FASolid" FontSize="14" TextColor="#666666" VerticalOptions="Center"/>
                                    <Label Text="{Binding hizmet_adi}" FontSize="16" FontAttributes="Bold" TextColor="#333333"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="14" TextColor="#666666" VerticalOptions="Center"/>
                                    <Label Text="{Binding arac_adi}" FontSize="14" TextColor="#666666" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,0,0,5"/>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Durum:" TextColor="#666666" FontAttributes="Bold"/>
                                <Label Text="{Binding durum}" TextColor="#00BCD4" FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <Border BackgroundColor="#E0F7FA" Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="10">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Maliyet:" TextColor="#00796B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="{Binding tahmini_tutar, StringFormat='{0} ₺'}" TextColor="#004D40" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="13" TextColor="#666666" VerticalOptions="Center"/>
                                <Label Text="İstediğiniz Tarih:" TextColor="#666666" FontSize="13" VerticalOptions="Center"/>
                                <Label Text="{Binding talep_tarihi}" TextColor="#111111" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5" IsVisible="{Binding onerilen_tarih_var_mi}">
                                <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="13" TextColor="#E53935" VerticalOptions="Center"/>
                                <Label Text="Önerilen Yeni Tarih:" TextColor="#E53935" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding onerilen_tarih}" TextColor="#E53935" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                            <Grid ColumnDefinitions="*, *">
                                <Button Grid.Column="0" Text="Düzenle" BackgroundColor="#00BCD4" TextColor="White" CornerRadius="8" Margin="0,0,5,0" Clicked="OnEditClicked" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1" Text="İptal Et" BackgroundColor="#FFEBEE" TextColor="#D32F2F" CornerRadius="8" Margin="5,0,0,0" Clicked="OnCancelClicked" CommandParameter="{Binding .}"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>