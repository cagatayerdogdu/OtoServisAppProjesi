<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             x:Class="OtoServisApp.Views.MyServiceRequestsView"
             BackgroundColor="#F4F6F8"
             Title="Servis Taleplerim">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="10,10,10,5" ZIndex="1">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                <Grid WidthRequest="200" VerticalOptions="Center" HorizontalOptions="Start">
                    <SearchBar x:Name="AramaBar" Placeholder="Araç veya Hizmet..." TextChanged="OnFiltreDegisti" BackgroundColor="#FAFAFA" TextColor="#111111" Margin="30,0,0,0"/>
                    <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="14" TextColor="#888888" HorizontalOptions="Start" VerticalOptions="Center" Margin="10,0,0,0"/>
                </Grid>

                <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                    <Label Text="Durum:" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="#333333"/>
                    <Button x:Name="SecilenDurumButonu" Text="Tümü" BackgroundColor="White" TextColor="#111111" BorderColor="#CCCCCC" BorderWidth="1" CornerRadius="15" HeightRequest="35" WidthRequest="110" FontSize="12" Padding="5,0" Clicked="OnFiltreAcKapat" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <Border x:Name="DurumSecimKutusu" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="0,60,15,0" ZIndex="99" HorizontalOptions="End" VerticalOptions="Start">
            <CollectionView x:Name="DurumListesi" HeightRequest="200" WidthRequest="110" SelectionMode="Single" SelectionChanged="OnFiltreSecildi">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding ., Mode=OneWay}" Padding="10" FontSize="12" TextColor="#111111"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <CollectionView x:Name="RequestsList" Grid.Row="1" Margin="20">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Spacing="10" Margin="0,50,0,0">
                    <Label Text="{x:Static helpers:IconFont.ClipboardList}" FontFamily="FASolid" FontSize="50" TextColor="#BDC3C7" HorizontalOptions="Center" Opacity="0.6"/>
                    <Label Text="Gösterilecek Talep Yok" TextColor="#7F8C8D" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Henüz bir servis talebiniz bulunmuyor veya arama kriterlerinizle eşleşen bir sonuç yok." TextColor="#95A5A6" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ServisTalebi">
                    <Border BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20" Margin="0,0,0,15">
                        <VerticalStackLayout Spacing="10">

                            <VerticalStackLayout Spacing="5" Margin="0,0,0,5">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.Wrench}" FontFamily="FASolid" FontSize="14" TextColor="#666666" VerticalOptions="Center"/>
                                    <Label Text="{Binding hizmet_adi, Mode=OneWay}" FontSize="16" FontAttributes="Bold" TextColor="#333333"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="14" TextColor="#666666" VerticalOptions="Center"/>
                                    <Label Text="{Binding arac_adi, Mode=OneWay}" FontSize="14" TextColor="#666666" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,0,0,5"/>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Durum:" TextColor="#666666" FontAttributes="Bold"/>
                                <Label Text="{Binding durum, Mode=OneWay}" TextColor="#00BCD4" FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <Border BackgroundColor="#E0F7FA" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Maliyet:" TextColor="#00796B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="{Binding tahmini_tutar, StringFormat='{0} ₺', Mode=OneWay}" TextColor="#004D40" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="13" TextColor="#666666" VerticalOptions="Center"/>
                                <Label Text="İstediğiniz Tarih:" TextColor="#666666" FontSize="13" VerticalOptions="Center"/>
                                <Label Text="{Binding talep_tarihi, Mode=OneWay}" TextColor="#111111" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5" IsVisible="{Binding duzeltme_istendi_mi, Mode=OneWay}" Margin="0,2,0,0">
                                <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="12" TextColor="#F57C00" VerticalOptions="Center"/>
                                <Label Text="Bu talep için düzeltme isteğiniz inceleniyor." TextColor="#F57C00" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5" IsVisible="{Binding onerilen_tarih_var_mi, Mode=OneWay}" Margin="0,5,0,0">
                                <Label Text="{x:Static helpers:IconFont.ExclamationTriangle}" FontFamily="FASolid" FontSize="13" TextColor="#E53935" VerticalOptions="Center"/>
                                <Label Text="Önerilen Yeni Tarih:" TextColor="#E53935" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding onerilen_tarih, Mode=OneWay}" TextColor="#E53935" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                            <Border BackgroundColor="#FFF3E0" Stroke="#FFCC80" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,10,0,10" IsVisible="{Binding foto_var_mi, Mode=OneWay}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{x:Static helpers:IconFont.Camera}" FontFamily="FASolid" FontSize="14" TextColor="#E65100" VerticalOptions="Center"/>
                                            <Label Text="Görsel Eklenmiş Talep" TextColor="#E65100" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <Label Text="Bu talebe detaylı hasar fotoğrafları yüklediniz." TextColor="#F57C00" FontSize="11"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Fotoğrafları Gör" BackgroundColor="#FF9800" TextColor="White" CornerRadius="6" HeightRequest="35" FontSize="12" FontAttributes="Bold" Padding="15,0" CommandParameter="{Binding .}" Clicked="OnViewPhotosClicked" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*, *">
                                <Button Grid.Column="0" Text="Düzenle" BackgroundColor="#00BCD4" TextColor="White" CornerRadius="8" Margin="0,0,5,0" Clicked="OnEditClicked" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1" Text="İptal Et" BackgroundColor="#FFEBEE" TextColor="#D32F2F" CornerRadius="8" Margin="5,0,0,0" Clicked="OnCancelClicked" CommandParameter="{Binding .}"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False" Grid.RowSpan="2">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Talepler Yükleniyor..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="Lütfen işlem bitene kadar bekleyiniz." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>