<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             x:Class="OtoServisApp.Views.AdminPastRequestsView"
             BackgroundColor="#F4F6F8"
             Title="Geçmiş Talepler">

    <Grid RowDefinitions="*">
        <CollectionView x:Name="PastRequestsList" Margin="15,15,15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,0,0,15" Stroke="#E0E0E0" StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding hizmet_adi}" FontSize="16" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="{Binding durum}" FontSize="13" FontAttributes="Bold" TextColor="#7F8C8D" Margin="0,3,0,0"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                    <Label Text="{Binding randevu_tarihi, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12" FontAttributes="Bold" TextColor="#555555"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="14" TextColor="#888888" VerticalOptions="Center"/>
                                <Label Text="{Binding kullanici_ad_soyad}" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="14" TextColor="#888888" VerticalOptions="Center"/>
                                <Label Text="{Binding arac_adi_tam}" FontSize="14" TextColor="#444444" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Border BackgroundColor="#E0F7FA" Stroke="Transparent" StrokeShape="RoundRectangle 5" Padding="10" Margin="0,5">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.Coins}" FontFamily="FASolid" FontSize="14" TextColor="#00796B" VerticalOptions="Center"/>
                                    <Label Text="Tutar:" FontSize="13" FontAttributes="Bold" TextColor="#00796B" VerticalOptions="Center"/>
                                    <Label Text="{Binding tahmini_tutar}" FontSize="13" FontAttributes="Bold" TextColor="#004D40" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>