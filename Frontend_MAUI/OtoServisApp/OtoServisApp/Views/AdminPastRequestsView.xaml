<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:OtoServisApp.Helpers"
             xmlns:models="clr-namespace:OtoServisApp.Models" 
             x:Class="OtoServisApp.Views.AdminPastRequestsView"
             BackgroundColor="#F4F6F8"
             Title="Geçmiş Talepler">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" BackgroundColor="#FAFAFA" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="10,10,10,5" ZIndex="1">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                <Grid WidthRequest="220" VerticalOptions="Center" HorizontalOptions="Start">
                    <SearchBar x:Name="AramaBar" Placeholder="Ad veya Araç..." TextChanged="OnFiltreDegisti" BackgroundColor="#FAFAFA" TextColor="#111111" Margin="30,0,0,0"/>
                    <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="14" TextColor="#888888" HorizontalOptions="Start" VerticalOptions="Center" Margin="10,0,0,0"/>
                </Grid>

                <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                    <Label Text="Durum:" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="#333333"/>
                    <Button x:Name="SecilenDurumButonu" Text="Tümü" BackgroundColor="White" TextColor="#111111" BorderColor="#CCCCCC" BorderWidth="1" CornerRadius="15" HeightRequest="35" WidthRequest="110" FontSize="12" Padding="5,0" Clicked="OnFiltreDurumKutusuAcKapat" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <Border x:Name="DurumSecimKutusu" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5" Margin="0,60,15,0" ZIndex="99" HorizontalOptions="End" VerticalOptions="Start">
            <CollectionView x:Name="DurumListesi" HeightRequest="110" WidthRequest="110" SelectionMode="Single" SelectionChanged="OnFiltreDurumSecildi">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding ., Mode=OneWay}" FontSize="12" TextColor="#111111"/>
                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <CollectionView x:Name="PastRequestsList" Grid.Row="1" Margin="15,10,15,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Spacing="10" Margin="0,50,0,0">
                    <Label Text="{x:Static helpers:IconFont.Search}" FontFamily="FASolid" FontSize="50" TextColor="#BDC3C7" HorizontalOptions="Center" Opacity="0.6"/>
                    <Label Text="Arama kriterlerinize uygun talep bulunamadı." TextColor="#7F8C8D" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Lütfen farklı bir kelime veya durum seçerek tekrar deneyin." TextColor="#95A5A6" FontSize="13" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ServisTalebi">
                    <Border BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,0,0,15" Stroke="#E0E0E0" StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding hizmet_adi, Mode=OneWay}" FontSize="16" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="{Binding durum, Mode=OneWay}" FontSize="13" FontAttributes="Bold" TextColor="#7F8C8D" Margin="0,3,0,0"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EEEEEE"/>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="14" TextColor="#888888" VerticalOptions="Center"/>
                                <Label Text="{Binding kullanici_ad_soyad, Mode=OneWay}" FontSize="14" TextColor="#333333" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{x:Static helpers:IconFont.Car}" FontFamily="FASolid" FontSize="14" TextColor="#888888" VerticalOptions="Center"/>
                                <Label Text="{Binding arac_adi_tam, Mode=OneWay}" FontSize="14" TextColor="#444444" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="5" Margin="0,5,0,0">

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.CalendarAlt}" FontFamily="FASolid" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                    <Label Text="Talep Tarihi:" FontSize="12" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="{Binding talep_tarihi, StringFormat='{}{0:dd.MM.yyyy HH:mm}', Mode=OneWay}" FontSize="12" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.CheckCircle}" FontFamily="FASolid" FontSize="12" TextColor="#25D366" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding durum}" Value="İptal Edildi">
                                                <Setter Property="Text" Value="{x:Static helpers:IconFont.TimesCircle}" />
                                                <Setter Property="TextColor" Value="#EF4444" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Text="Tamamlanma:" FontSize="12" TextColor="#25D366" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding durum}" Value="İptal Edildi">
                                                <Setter Property="Text" Value="İptal Tarihi:" />
                                                <Setter Property="TextColor" Value="#EF4444" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Text="{Binding tamamlanma_tarihi, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Belirtilmemiş', Mode=OneWay}" FontSize="12" TextColor="#334155" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding durum}" Value="İptal Edildi">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Text="{Binding silinme_tarihi, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Belirtilmemiş', Mode=OneWay}" FontSize="12" TextColor="#EF4444" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding durum}" Value="Tamamlandı">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="5">
                                    <HorizontalStackLayout.Triggers>
                                        <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding durum}" Value="İptal Edildi">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding durum}" Value="Tamamlandı">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </HorizontalStackLayout.Triggers>

                                    <Label Text="{x:Static helpers:IconFont.User}" FontFamily="FASolid" FontSize="12" TextColor="#EF4444" VerticalOptions="Center"/>
                                    <Label Text="İptal Eden:" FontSize="12" TextColor="#EF4444" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Text="{Binding iptal_eden_ad_soyad, TargetNullValue='Bilinmiyor', Mode=OneWay}" FontSize="12" TextColor="#EF4444" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                            <Border BackgroundColor="#E0F7FA" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10" Margin="0,5">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{x:Static helpers:IconFont.Coins}" FontFamily="FASolid" FontSize="14" TextColor="#00796B" VerticalOptions="Center"/>
                                    <Label Text="Tutar:" FontSize="13" FontAttributes="Bold" TextColor="#00796B" VerticalOptions="Center"/>
                                    <Label Text="{Binding tahmini_tutar, Mode=OneWay}" FontSize="13" FontAttributes="Bold" TextColor="#004D40" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False" InputTransparent="False" Grid.RowSpan="2">
            <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="#00BCD4" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingTitle" Text="Veriler Yükleniyor..." FontSize="16" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    <Label x:Name="LoadingSubText" Text="Lütfen işlem bitene kadar bekleyiniz." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>