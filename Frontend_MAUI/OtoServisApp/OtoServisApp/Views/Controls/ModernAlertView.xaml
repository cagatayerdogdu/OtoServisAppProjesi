<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.Controls.ModernAlertView"
             BackgroundColor="#80000000"
             IsVisible="False"
             InputTransparent="False"
             ZIndex="9999">

    <!-- Arka plan tıklamalarını yutmak için TapGestureRecognizer ekliyoruz -->
    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <Border BackgroundColor="#00BCD4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="20"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="300"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15" InputTransparent="False">
                <Label x:Name="MesajLabel" 
                       Text="Mesaj içeriği burada görünecek." 
                       TextColor="White" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       InputTransparent="True"/>

                <Grid x:Name="ButonlarGrid" 
                      ColumnDefinitions="*, *" 
                      ColumnSpacing="10" 
                      Margin="0,5,0,0"
                      IsVisible="False"
                      InputTransparent="False"/>

                <Border x:Name="TekButonBorder" 
                        BackgroundColor="White" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 10" 
                        HeightRequest="45" 
                        Margin="0,5,0,0"
                        IsVisible="False"
                        InputTransparent="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTekButonTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="TekButonLabel" 
                           Text="Tamam" 
                           TextColor="#00BCD4" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" 
                           InputTransparent="True"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>