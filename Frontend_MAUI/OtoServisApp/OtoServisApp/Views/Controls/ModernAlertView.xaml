<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OtoServisApp.Views.Controls.ModernAlertView"
             BackgroundColor="#80000000"
             IsVisible="False"
             InputTransparent="False"
             ZIndex="9999">

    <Grid>
        <!-- Beyaz Kart -->
        <Border BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="25,20"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="#40000000" 
                        Offset="0,8" 
                        Radius="20" 
                        Opacity="0.3"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="15" InputTransparent="False">
                <!-- Başlık -->
                <Label x:Name="BaslikLabel" 
                       Text="Başlık" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#222222" 
                       HorizontalTextAlignment="Center"
                       IsVisible="False"
                       InputTransparent="True"/>

                <!-- Mesaj -->
                <Label x:Name="MesajLabel" 
                       Text="Mesaj içeriği burada görünecek." 
                       FontSize="15" 
                       TextColor="#444444" 
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       InputTransparent="True"/>

                <!-- Çoklu Buton Grid'i -->
                <Grid x:Name="ButonlarGrid" 
                      ColumnDefinitions="*, *" 
                      ColumnSpacing="10" 
                      Margin="0,10,0,0"
                      IsVisible="False"
                      InputTransparent="False"/>

                <!-- Tek Buton -->
                <Border x:Name="TekButonBorder" 
                        BackgroundColor="#00BCD4" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 10" 
                        HeightRequest="45" 
                        Margin="0,10,0,0"
                        IsVisible="False"
                        InputTransparent="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTekButonTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="TekButonLabel" 
                           Text="Tamam" 
                           TextColor="White" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" 
                           InputTransparent="True"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>