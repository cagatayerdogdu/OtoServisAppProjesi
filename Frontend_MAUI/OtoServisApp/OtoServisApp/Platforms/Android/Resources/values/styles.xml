<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- MainActivity'de kullanılan splash teması ile aynı isim -->
  <style name="Maui.SplashTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <!-- Dokunma geri bildirimi (ripple) rengini transparan yap -->
    <item name="android:colorControlHighlight">@android:color/transparent</item>
    <!-- Opsiyonel: Aktif durum rengini de transparan yap -->
    <item name="android:colorControlActivated">@android:color/transparent</item>
    <!-- Odaklanma kenarlığını kapat -->
    <item name="android:focusable">false</item>
    <item name="android:focusableInTouchMode">false</item>
  </style>
</resources>